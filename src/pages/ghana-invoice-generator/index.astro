---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl = 'https://afrinvoice.app/ghana-invoice-generator/';
const schema    = webAppSchema(
  'Ghana Invoice Generator — GRA VAT 20% Pre-filled',
  pageUrl,
  'Create professional Ghana invoices with GRA VAT pre-filled (20% total: 15% VAT + NHIL + GETFund). Add MTN MoMo, Telecel Cash, or AirtelTigo payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Ghana Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Ghana invoice generator auto-fill GRA VAT?',
    a: 'Yes. The tool pre-fills <strong>20% GRA VAT + levies</strong> for Ghana (15% statutory VAT + 2.5% NHIL + 2.5% GETFund, as per Ghana VAT Act 2025 effective January 2026). The rate is editable — set to 0% for zero-rated export services.',
  },
  {
    q: 'Can I add MTN MoMo payment instructions to my Ghana invoice?',
    a: 'Yes. The payment section defaults to Mobile Money for Ghana. Choose MTN MoMo, Telecel Cash (formerly Vodafone Cash), or AirtelTigo Money from the dropdown — the correct account label and format hint appear automatically.',
  },
  {
    q: 'What currency does the Ghana invoice use?',
    a: 'The invoice uses <strong>Ghana Cedi (GH₵ / GHS)</strong> by default. All amounts — subtotal, GRA VAT, and total — display in GH₵.',
  },
  {
    q: 'Is this tool compliant with GRA invoice requirements?',
    a: 'The tool generates invoices that include the standard fields GRA expects: business name, client name, invoice number, date, itemised line items, VAT rate (20% total for registered businesses), and totals. For VAT-registered businesses issuing eTVS receipts, you still need to file through the GRA portal — this tool is for standard invoice documents.',
  },
  {
    q: 'Can I issue invoices in USD for international clients from Ghana?',
    a: 'Yes. Change the currency symbol to <strong>$</strong> and the code to <strong>USD</strong> in the Invoice Details section. The PDF will reflect the new currency. You can also set the tax rate to 0% for zero-rated exports.',
  },
  {
    q: 'Will my business details save for my next Ghana invoice?',
    a: 'Yes. Your business name, email, phone, address, logo, and MoMo or bank details are saved automatically in your browser. They reload the next time you visit — no account needed.',
  },
];
---

<Base
  title="Ghana Invoice Generator — GRA VAT 20%"
  description="Create Ghana invoices with GRA VAT pre-filled (20% total). Add MTN MoMo, Telecel Cash, or AirtelTigo payment instructions. Free PDF download, no sign-up."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="country-hero" aria-labelledby="gh-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Ghana Invoice Generator</span>
      </nav>

      <div class="country-badge">
        <span aria-hidden="true">🇬🇭</span>
        Ghana · GHS · GRA VAT 20%
      </div>

      <h1 id="gh-heading" class="country-heading">
        Ghana Invoice Generator<br />
        <span class="shimmer">with GRA VAT auto-filled</span>
      </h1>

      <p class="country-sub">
        Select Ghana and your invoice is ready: <strong>GH₵ currency</strong>, <strong>GRA VAT (20% total)</strong>,
        and <strong>MTN MoMo</strong> payment fields. Download a professional PDF instantly.
        No account. No watermark.
      </p>

      <div class="country-highlights">
        <div class="highlight">
          <span class="hl-val">20%</span>
          <span class="hl-label">GRA VAT + Levies</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">GH₵</span>
          <span class="hl-label">Ghana Cedi</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">MoMo</span>
          <span class="hl-label">MTN · Telecel · AirtelTigo</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Invoice Generator ──────────────────────────────────────────── -->
  <section class="tool-section" aria-label="Ghana invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="ghana" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <!-- ── Affiliate callout ──────────────────────────────────────────── -->
  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <!-- ── Guide cross-link ─────────────────────────────────────────── -->
  <div class="container guide-link-wrap">
    <a href="/how-to-invoice-ghana/" class="guide-link">
      New to invoicing in Ghana? Read our complete guide →
    </a>
  </div>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="gh-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Ghana Invoice Generator — FAQs" />
    </div>
  </section>

</Base>

<style>
  .country-hero {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-4);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }

  .country-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.875rem;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.18);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #D97706;
    margin-bottom: 1.25rem;
  }

  .country-heading {
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .country-sub {
    font-size: clamp(1rem, 2vw, 1.0625rem);
    color: var(--text-3);
    line-height: 1.75;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .country-sub strong { color: var(--text-2); font-weight: 500; }

  .country-highlights {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .hl-val {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    font-family: 'Sora', sans-serif;
    line-height: 1;
  }

  .hl-label {
    font-size: 0.6875rem;
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .hl-sep {
    width: 1px;
    height: 2rem;
    background: var(--border);
    flex-shrink: 0;
  }

  .tool-section { padding: 0 0 2rem; }

  .tool-shell {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface);
    min-height: 640px;
    display: flex;
    flex-direction: column;
  }

  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
