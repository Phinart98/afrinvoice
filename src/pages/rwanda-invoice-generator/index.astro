---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/rwanda-invoice-generator/';
const schema   = webAppSchema(
  'Rwanda Invoice Generator — RRA VAT 18% Pre-filled',
  pageUrl,
  'Create professional Rwanda invoices with RRA VAT 18% auto-filled. MTN MoMo and Airtel Money payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Rwanda Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Rwanda invoice generator auto-fill RRA VAT?',
    a: 'Yes. Rwanda Revenue Authority (RRA) VAT at <strong>18%</strong> is pre-filled when you select Rwanda. Rwanda also has a high WHT rate (15% on dividends and service fees to non-residents) — note this in the invoice if relevant.',
  },
  {
    q: 'Can I add MTN MoMo payment instructions to my Rwanda invoice?',
    a: 'Yes. Rwanda defaults to Mobile Money with MTN MoMo pre-selected. Enter your number in the format 078XXXXXXX. Airtel Money is also available.',
  },
  {
    q: 'What currency does the Rwanda invoice use?',
    a: 'Rwanda Franc (FRw / RWF). All amounts display in FRw.',
  },
  {
    q: 'Is Rwanda a good market for freelancers to invoice international clients?',
    a: 'Rwanda is a growing tech and services hub — especially Kigali. Many Rwandan freelancers invoice international clients in USD via Wise or Payoneer. Change the currency to USD and set tax to 0% for export services.',
  },
];
---

<Base
  title="Rwanda Invoice Generator — RRA VAT 18% Auto-filled Free — Afrinvoice"
  description="Create Rwanda invoices with RRA VAT 18% pre-filled. MTN MoMo and Airtel Money payment instructions. Free PDF download, no sign-up."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="rw-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Rwanda Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇷🇼</span> Rwanda · RWF · RRA VAT 18%</div>
      <h1 id="rw-heading" class="country-heading">
        Rwanda Invoice Generator<br />
        <span class="shimmer">with RRA VAT auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Rwanda: <strong>FRw currency</strong>, <strong>RRA VAT 18%</strong>, and <strong>MTN MoMo</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">18%</span><span class="hl-label">RRA VAT rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">FRw</span><span class="hl-label">Rwanda Franc</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">MoMo</span><span class="hl-label">MTN · Airtel Money</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Rwanda invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="rwanda" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <section class="section" aria-labelledby="rw-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Rwanda Invoice Generator — FAQs" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
