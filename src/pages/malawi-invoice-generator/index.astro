---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/malawi-invoice-generator/';
const schema   = webAppSchema(
  'Malawi Invoice Generator — MRA VAT 17.5% Pre-filled',
  pageUrl,
  'Create professional Malawi invoices with MRA VAT 17.5% auto-filled. Airtel Money and TNM Mpamba payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Malawi Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Malawi invoice generator auto-fill MRA VAT?',
    a: 'Yes. Malawi Revenue Authority (MRA) VAT at <strong>17.5%</strong> is pre-filled when you select Malawi. This rate was raised from 16.5% effective January 2026 under the Value Added Tax Amendment Act 2025.',
  },
  {
    q: 'What is TNM Mpamba?',
    a: '<strong>TNM Mpamba</strong> is the mobile money service offered by Telekom Networks Malawi (TNM). Alongside Airtel Money, it is one of the two main mobile money platforms in Malawi. Enter your Mpamba number in the format 088XXXXXXX.',
  },
  {
    q: 'What currency does the Malawi invoice use?',
    a: 'Malawian Kwacha (MWK), displayed as <strong>MK</strong>. All amounts — subtotal, MRA VAT 17.5%, and total — appear in Kwacha.',
  },
  {
    q: 'Can I invoice international clients from Malawi in USD?',
    a: 'Yes. Many Malawian freelancers and exporters invoice in USD to avoid exchange rate exposure. Change the currency to USD in the tool, set tax to 0% for export services, and provide your USD bank account or Payoneer details.',
  },
];
---

<Base
  title="Malawi Invoice Generator — MRA VAT 17.5%"
  description="Create Malawi invoices with MRA VAT 17.5% pre-filled. Airtel Money and TNM Mpamba payment instructions included. Free PDF download, no sign-up required."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="mw-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Malawi Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇲🇼</span> Malawi · MWK · MRA VAT 17.5%</div>
      <h1 id="mw-heading" class="country-heading">
        Malawi Invoice Generator<br />
        <span class="shimmer">with MRA VAT auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Malawi: <strong>Kwacha currency</strong>, <strong>MRA VAT 17.5%</strong>, and <strong>Airtel Money</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">17.5%</span><span class="hl-label">MRA VAT rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">MK</span><span class="hl-label">Malawian Kwacha</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">MoMo</span><span class="hl-label">Airtel Money · Mpamba</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Malawi invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="malawi" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/mobile-money-invoice/" class="guide-link">Invoice with mobile money payment fields →</a>
  </div>

  <section class="section" aria-labelledby="mw-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Malawi Invoice Generator — FAQs" headingId="mw-faq-heading" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
