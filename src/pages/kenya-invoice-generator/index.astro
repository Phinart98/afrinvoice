---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/kenya-invoice-generator/';
const schema   = webAppSchema(
  'Kenya Invoice Generator — KRA VAT 16% Pre-filled',
  pageUrl,
  'Create professional Kenya invoices with KRA VAT 16% auto-filled. Add M-Pesa payment instructions. Free PDF download, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Kenya Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Kenya invoice generator auto-fill KRA VAT?',
    a: 'Yes. Kenya Revenue Authority (KRA) VAT at <strong>16%</strong> is pre-filled when you select Kenya. The rate and label are editable — useful for exempt supplies (e.g. financial services, medical) or zero-rated exports.',
  },
  {
    q: 'Can I add M-Pesa payment instructions to my Kenya invoice?',
    a: 'Yes. The payment section defaults to Mobile Money for Kenya with M-Pesa pre-selected. Your Safaricom number appears as the payment destination. Airtel Money is also available in the dropdown.',
  },
  {
    q: 'What currency does the Kenya invoice use?',
    a: 'The invoice uses <strong>Kenya Shilling (KSh / KES)</strong> by default. All line item amounts, KRA VAT (16%), and totals display in KSh.',
  },
  {
    q: 'Does this cover KRA eTIMS invoicing requirements?',
    a: 'This tool generates standard invoice documents that include all required fields: business details, client details, itemised services, KRA VAT 16%, and totals. For businesses required to use KRA eTIMS (Electronic Tax Invoice Management System), you still need to submit through the KRA portal — this tool helps you draft the invoice first.',
  },
  {
    q: 'Can I issue invoices in USD for international clients from Kenya?',
    a: 'Yes. Change the currency symbol to <strong>$</strong> and code to <strong>USD</strong>. For export services, set the tax rate to 0% (zero-rated under KRA rules). Many Kenyan freelancers on Upwork and Toptal invoice in USD.',
  },
  {
    q: 'Does Withholding Tax (WHT) appear on Kenya invoices?',
    a: 'WHT in Kenya (5% for services) is typically deducted by the client at payment — not added as a line on the invoice. You can add a Notes line like "Subject to 5% WHT — client to remit to KRA" to clarify. The tax field is reserved for KRA VAT.',
  },
];
---

<Base
  title="Kenya Invoice Generator — KRA VAT 16%"
  description="Create Kenya invoices with KRA VAT 16% pre-filled. Add M-Pesa payment instructions. Free PDF download, no sign-up. Built for Kenyan freelancers and businesses."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="country-hero" aria-labelledby="ke-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Kenya Invoice Generator</span>
      </nav>

      <div class="country-badge">
        <span aria-hidden="true">🇰🇪</span>
        Kenya · KES · KRA VAT 16%
      </div>

      <h1 id="ke-heading" class="country-heading">
        Kenya Invoice Generator<br />
        <span class="shimmer">with KRA VAT auto-filled</span>
      </h1>

      <p class="country-sub">
        Select Kenya and your invoice is ready: <strong>KSh currency</strong>, <strong>KRA VAT 16%</strong>,
        and <strong>M-Pesa payment fields</strong>. Download a professional PDF instantly.
        No account. No watermark.
      </p>

      <div class="country-highlights">
        <div class="highlight">
          <span class="hl-val">16%</span>
          <span class="hl-label">KRA VAT rate</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">KSh</span>
          <span class="hl-label">Kenya Shilling</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">M-Pesa</span>
          <span class="hl-label">Safaricom · Airtel Money</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Invoice Generator ──────────────────────────────────────────── -->
  <section class="tool-section" aria-label="Kenya invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="kenya" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <!-- ── Affiliate callout ──────────────────────────────────────────── -->
  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/how-to-invoice-kenya/" class="guide-link">New to invoicing in Kenya? Read our complete guide →</a>
  </div>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="ke-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Kenya Invoice Generator — FAQs" />
    </div>
  </section>

</Base>

<style>
  .country-hero {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-4);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }

  .country-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.875rem;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.18);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #D97706;
    margin-bottom: 1.25rem;
  }

  .country-heading {
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .country-sub {
    font-size: clamp(1rem, 2vw, 1.0625rem);
    color: var(--text-3);
    line-height: 1.75;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .country-sub strong { color: var(--text-2); font-weight: 500; }

  .country-highlights {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .hl-val {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    font-family: 'Sora', sans-serif;
    line-height: 1;
  }

  .hl-label {
    font-size: 0.6875rem;
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .hl-sep {
    width: 1px;
    height: 2rem;
    background: var(--border);
    flex-shrink: 0;
  }

  .tool-section { padding: 0 0 2rem; }

  .tool-shell {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface);
    min-height: 640px;
    display: flex;
    flex-direction: column;
  }

  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
