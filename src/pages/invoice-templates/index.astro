---
import Base from '../../layouts/Base.astro';
import FaqSection from '../../components/FaqSection.astro';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';
import { SITE, abs } from '../../site';

const pageUrl   = abs('/invoice-templates/');
const schema    = webAppSchema(
  'Free invoice templates in six PDF designs',
  pageUrl,
  'Free invoice templates you fill in online: Minimal, Letterhead and Band PDF designs free, plus Sidebar, Accounts and Studio with Pro. Your logo, country tax presets and payment QR codes. No sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: SITE.name, url: abs('/') },
  { name: 'Invoice templates', url: pageUrl },
]);

// The images are real first pages of each PDF (scripts render them from the generator's own code).
// Free designs are shown as free downloads look, with the small credit line; Pro ones without it.
const templates = [
  { id: 'minimal', name: 'Minimal', pro: false,
    description: 'Black and white with thin rules. The invoice number and the amount due are the two big figures, so a client finds both at once. Prints well on any printer.',
    best: 'Anyone, and the safest choice for a new client' },
  { id: 'classic', name: 'Letterhead', pro: false,
    description: 'A traditional business letter: a centred serif letterhead over a double rule, dates set out in a small grid, and ruled rows. You pick the colour of the rules and total.',
    best: 'Consultants, lawyers and accountants' },
  { id: 'modern', name: 'Band', pro: false,
    description: 'A colour band across the top that shows the amount due and the due date before anything else. Shaded rows keep long lists readable. Band and accent colours are yours.',
    best: 'Agencies and studios with a house colour' },
  { id: 'executive', name: 'Sidebar', pro: true,
    description: 'A solid panel in your brand colour holds who it’s from, who it’s for and how to pay, with the QR code. The main column is left for the work and the total.',
    best: 'Long bank details: IBAN, SWIFT, UPI or mobile money' },
  { id: 'ledger', name: 'Accounts', pro: true,
    description: 'Summary boxes for number, date, due date and amount due, numbered lines in a ruled grid, and the accountant’s double rule under the total.',
    best: 'Clients whose accounts team checks every line' },
  { id: 'studio', name: 'Studio', pro: true,
    description: 'The amount due is the headline, large on a block of your brand colour. Items read as a list, each with its quantity and price underneath.',
    best: 'Designers, photographers and other creatives' },
];

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Are these invoice templates free to download?',
    a: 'Minimal, Letterhead and Band are free with no account and no hidden fees. The PDF has no watermark across it, only one small credit line at the bottom. Sidebar, Accounts and Studio come with <a href="/pro/">Pro</a>, a one-time payment that also removes the credit line.',
  },
  {
    q: 'Do the templates work for my country?',
    a: 'Yes. The template only controls the design; the country data (currency, tax lines, tax ID label, payment methods, paper size, language) is separate. Pick your country first, then whichever template you like.',
  },
  {
    q: 'Can I change the colours?',
    a: 'Yes. Letterhead lets you pick the colour of its rules and total, and Band its band and accent colours, for free. The Pro designs use your brand colour, and with Pro you can also colour Minimal’s amount due.',
  },
  {
    q: 'Can I add my logo and signature?',
    a: 'Your logo is free on every template: upload it in the Your business section. A signature with your name under it is a Pro option, along with a Paid or Draft stamp and a choice of sans or serif type.',
  },
  {
    q: 'Which template should I use?',
    a: '<strong>Minimal</strong> is accepted everywhere. <strong>Letterhead</strong> suits formal clients. <strong>Band</strong> puts the amount due first. With Pro, <strong>Sidebar</strong> fits long payment details, <strong>Accounts</strong> suits finance teams, and <strong>Studio</strong> is for creative work.',
  },
];
---

<Base
  title="Free Invoice Templates to Fill In Online and Download as PDF"
  description="Six invoice designs you fill in online and download as PDF: Minimal, Letterhead and Band free, Sidebar, Accounts and Studio with Pro. Your logo, local taxes, any currency."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <section class="tpl-hero" aria-labelledby="tpl-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">{SITE.name}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Invoice templates</span>
      </nav>
      <h1 id="tpl-heading" class="tpl-heading">Invoice templates you fill in online</h1>
      <p class="tpl-sub">
        Six PDF designs, each with your logo and the right taxes for your country. Three are free;
        three more come with <a href="/pro/">Pro</a>. Pick one, fill in your details and download the PDF.
      </p>
    </div>
  </section>

  <section class="section-sm" aria-labelledby="gallery-heading">
    <div class="container">
      <h2 id="gallery-heading" class="sr-only">Template designs</h2>
      <div class="gallery">
        {templates.map(t => (
          <article class="tpl-card">
            <a href={`/#template=${t.id}`} class="tpl-shot" aria-label={`Use the ${t.name} template`}>
              <img src={`/templates/${t.id}.jpg`} width="640" height="905" loading="lazy" decoding="async"
                alt={`The ${t.name} invoice template: a sample UK invoice for three items with VAT`} />
            </a>
            <div class="tpl-info">
              <div class="tpl-name-row">
                <h3 class="tpl-name">{t.name}</h3>
                <span class:list={['tpl-tag', { 'tpl-tag--pro': t.pro }]}>{t.pro ? 'Pro' : 'Free'}</span>
              </div>
              <p class="tpl-desc">{t.description}</p>
              <p class="tpl-best">Best for: <strong>{t.best}</strong></p>
              <a href={`/#template=${t.id}`} class="tpl-use-btn">Use {t.name}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tpl-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Questions about the templates" headingId="tpl-faq-heading" />
    </div>
  </section>

</Base>

<style>
  .tpl-hero { padding: 4rem 0 2.5rem; }
  .breadcrumb { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .tpl-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 38rem; }
  .tpl-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0; }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 960px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .gallery { grid-template-columns: 1fr; } }

  .tpl-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; }
  /* The PDF page sits on a desk, the same way the generator shows it */
  .tpl-shot { display: block; background: var(--desk); padding: 1.25rem 1.25rem 0; border-bottom: 1px solid var(--border); }
  .tpl-shot img { display: block; width: 100%; height: auto; aspect-ratio: 640 / 905; object-fit: cover; object-position: top;
    max-height: 340px; border-radius: 3px 3px 0 0; box-shadow: 0 0 0 1px var(--border); }
  .tpl-shot:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  .tpl-info { padding: 1.125rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .tpl-name-row { display: flex; align-items: center; gap: 0.5rem; }
  .tpl-name { font-size: 1.125rem; margin: 0; color: var(--text); }
  .tpl-tag { font-size: 0.6875rem; font-weight: 700; padding: 0.1rem 0.5rem; border-radius: 999px; border: 1px solid var(--border); color: var(--text-3); }
  .tpl-tag--pro { background: var(--text); border-color: var(--text); color: var(--surface); }
  .tpl-desc { font-size: 0.875rem; line-height: 1.6; color: var(--text-3); margin: 0; }
  .tpl-best { font-size: 0.75rem; color: var(--text-4); margin: 0; }
  .tpl-best strong { color: var(--text-3); }
  .tpl-use-btn { display: inline-flex; align-items: center; padding: 0.5rem 1rem; background: var(--accent); color: var(--on-accent);
    font-size: 0.8125rem; font-weight: 700; border-radius: 6px; text-decoration: none; align-self: flex-start; margin-top: auto; }
  .tpl-use-btn:hover { background: var(--accent-hover); color: var(--on-accent); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
