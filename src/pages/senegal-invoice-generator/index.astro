---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/senegal-invoice-generator/';
const schema   = webAppSchema(
  'Senegal Invoice Generator — DGI TVA 18% Pre-filled',
  pageUrl,
  'Create professional Senegal invoices with DGI TVA 18% auto-filled. Orange Money and Wave payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Senegal Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Senegal invoice generator auto-fill TVA?',
    a: 'Yes. Senegal\'s Direction Générale des Impôts (DGI) TVA at <strong>18%</strong> is pre-filled when you select Senegal. This is the standard UEMOA rate. Export services to clients outside the UEMOA zone are typically zero-rated.',
  },
  {
    q: 'Should I use Wave or Orange Money on my Senegal invoice?',
    a: '<strong>Wave</strong> has grown explosively in Senegal due to its zero-fee transfers, making it increasingly popular for business payments. <strong>Orange Money</strong> remains the largest by total users. List both if your clients prefer different providers. Wave numbers use the 70 prefix; Orange Money uses 77.',
  },
  {
    q: 'What currency does the Senegal invoice use?',
    a: 'West African CFA Franc (XOF), displayed as <strong>FCFA</strong>. The FCFA is shared across eight UEMOA member states and is pegged to the Euro, making it one of the most stable currencies in Africa.',
  },
  {
    q: 'Is Dakar a good base for invoicing international clients?',
    a: 'Yes. Dakar is a growing tech hub with a strong freelance ecosystem. Many Senegalese developers and consultants invoice international clients in EUR or USD. Change the currency in the tool and set TVA to 0% for export services. Wise and Payoneer are commonly used for receiving international payments.',
  },
];
---

<Base
  title="Senegal Invoice Generator — DGI TVA 18%"
  description="Create Senegal invoices with DGI TVA 18% pre-filled. Orange Money and Wave (zero-fee) payment instructions included. Free PDF download, no sign-up required."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="sn-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Senegal Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇸🇳</span> Senegal · XOF · TVA 18%</div>
      <h1 id="sn-heading" class="country-heading">
        Senegal Invoice Generator<br />
        <span class="shimmer">with DGI TVA auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Senegal: <strong>FCFA currency</strong>, <strong>TVA 18%</strong>, and <strong>Orange Money</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">18%</span><span class="hl-label">DGI TVA rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">FCFA</span><span class="hl-label">CFA Franc (XOF)</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">Wave</span><span class="hl-label">Orange Money · Wave</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Senegal invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="senegal" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/mobile-money-invoice/" class="guide-link">Invoice with mobile money payment fields →</a>
  </div>

  <section class="section" aria-labelledby="sn-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Senegal Invoice Generator — FAQs" headingId="sn-faq-heading" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
