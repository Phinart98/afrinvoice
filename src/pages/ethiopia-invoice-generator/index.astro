---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/ethiopia-invoice-generator/';
const schema   = webAppSchema(
  'Ethiopia Invoice Generator — ERCA VAT 15% Pre-filled',
  pageUrl,
  'Create professional Ethiopia invoices with ERCA VAT 15% auto-filled. Telebirr and M-Pesa payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Ethiopia Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Ethiopia invoice generator auto-fill ERCA VAT?',
    a: 'Yes. Ethiopian Revenue and Customs Authority (ERCA) VAT at <strong>15%</strong> is pre-filled when you select Ethiopia. The rate is editable for exempt or zero-rated supplies — export services are typically zero-rated under Ethiopian law.',
  },
  {
    q: 'What is Telebirr and why is it listed first?',
    a: 'Telebirr is the mobile money service run by <strong>Ethio Telecom</strong>, the state-owned telecoms operator. Launched in 2021, it rapidly became Ethiopia\'s dominant mobile money platform with over 50 million users as of 2025. Enter your number in the format 09XXXXXXXX.',
  },
  {
    q: 'What currency does the Ethiopia invoice use?',
    a: 'Ethiopian Birr (ETB), displayed as <strong>Br</strong>. All amounts — subtotal, ERCA VAT 15%, and total — appear in Birr.',
  },
  {
    q: 'Can I invoice international clients in USD from Ethiopia?',
    a: 'Yes. Many Ethiopian freelancers and exporters invoice in USD. Change the currency to USD in the tool, set tax to 0% for export services, and include your bank details (USD accounts at Ethiopian commercial banks) or a Payoneer account number.',
  },
];
---

<Base
  title="Ethiopia Invoice Generator — ERCA VAT 15%"
  description="Create Ethiopia invoices with ERCA VAT 15% pre-filled. Telebirr (50M+ users) and M-Pesa payment instructions included. Free PDF download, no sign-up required."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="et-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Ethiopia Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇪🇹</span> Ethiopia · ETB · ERCA VAT 15%</div>
      <h1 id="et-heading" class="country-heading">
        Ethiopia Invoice Generator<br />
        <span class="shimmer">with ERCA VAT auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Ethiopia: <strong>Birr currency</strong>, <strong>ERCA VAT 15%</strong>, and <strong>Telebirr</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">15%</span><span class="hl-label">ERCA VAT rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">Br</span><span class="hl-label">Ethiopian Birr</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">Telebirr</span><span class="hl-label">Ethio Telecom · M-Pesa</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Ethiopia invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="ethiopia" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/mobile-money-invoice/" class="guide-link">Invoice with mobile money payment fields →</a>
  </div>

  <section class="section" aria-labelledby="et-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Ethiopia Invoice Generator — FAQs" headingId="et-faq-heading" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
