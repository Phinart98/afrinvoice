---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/nigeria-invoice-generator/';
const schema   = webAppSchema(
  'Nigeria Invoice Generator — NRS VAT 7.5% Pre-filled',
  pageUrl,
  'Create professional Nigeria invoices with NRS VAT 7.5% auto-filled. Bank transfer fields for B2B. OPay and PalmPay mobile options. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Nigeria Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Nigeria invoice generator auto-fill the NRS VAT rate?',
    a: 'Yes. Nigeria Revenue Service (NRS) VAT at <strong>7.5%</strong> is pre-filled when you select Nigeria. The label and rate are editable — useful for zero-rated services or exempt supplies.',
  },
  {
    q: 'Why does the Nigeria generator default to bank transfer instead of mobile money?',
    a: 'Bank transfer (NEFT/NIBSS) is the standard for B2B invoicing in Nigeria. OPay and PalmPay are excellent for consumer payments but most Nigerian businesses expect an account number on an invoice, not a mobile wallet. You can switch to Mobile Money if your clients prefer it.',
  },
  {
    q: 'Can I add OPay or PalmPay payment details to my Nigeria invoice?',
    a: 'Yes. Switch the Payment Details section to Mobile Money, then choose OPay, PalmPay, MTN MoMo (PSB), or Kuda from the dropdown. Your phone number and account name appear on the invoice.',
  },
  {
    q: 'What currency does the Nigeria invoice use?',
    a: 'The invoice uses <strong>Nigerian Naira (₦ / NGN)</strong> by default. All amounts — subtotal, NRS VAT, and total — display in ₦.',
  },
  {
    q: 'Does this tool handle Withholding Tax (WHT) for Nigeria?',
    a: 'The tax section lets you set any label and rate. For WHT (typically 5% on services, 10% on consultancy), add a Notes line mentioning WHT — most Nigerian clients handle the remittance themselves and expect to see it referenced in the invoice notes rather than as a deduction line.',
  },
  {
    q: 'Can I issue invoices in USD for international clients from Nigeria?',
    a: 'Yes. Change the currency symbol to <strong>$</strong> and code to <strong>USD</strong>. Set tax to 0% for export services (typically zero-rated under NRS rules). Many Nigerian freelancers invoice international clients in USD and receive payments via Wise or Payoneer.',
  },
];
---

<Base
  title="Nigeria Invoice Generator — NRS VAT 7.5%"
  description="Create Nigeria invoices with NRS VAT 7.5% pre-filled. Bank transfer fields for B2B invoicing. OPay, PalmPay mobile options. Free PDF, no sign-up."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="country-hero" aria-labelledby="ng-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Nigeria Invoice Generator</span>
      </nav>

      <div class="country-badge">
        <span aria-hidden="true">🇳🇬</span>
        Nigeria · NGN · NRS VAT 7.5%
      </div>

      <h1 id="ng-heading" class="country-heading">
        Nigeria Invoice Generator<br />
        <span class="shimmer">with NRS VAT auto-filled</span>
      </h1>

      <p class="country-sub">
        Select Nigeria and your invoice is ready: <strong>₦ currency</strong>, <strong>NRS VAT 7.5%</strong>,
        and <strong>bank transfer fields</strong> for professional B2B invoicing.
        Download a clean PDF instantly. No account. No watermark.
      </p>

      <div class="country-highlights">
        <div class="highlight">
          <span class="hl-val">7.5%</span>
          <span class="hl-label">NRS VAT rate</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">₦</span>
          <span class="hl-label">Nigerian Naira</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">Bank</span>
          <span class="hl-label">NEFT · OPay · PalmPay</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Invoice Generator ──────────────────────────────────────────── -->
  <section class="tool-section" aria-label="Nigeria invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="nigeria" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <!-- ── Affiliate callout ──────────────────────────────────────────── -->
  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/how-to-invoice-nigeria/" class="guide-link">New to invoicing in Nigeria? Read our complete guide →</a>
  </div>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="ng-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Nigeria Invoice Generator — FAQs" />
    </div>
  </section>

</Base>

<style>
  .country-hero {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-4);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }

  .country-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.875rem;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.18);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #D97706;
    margin-bottom: 1.25rem;
  }

  .country-heading {
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .country-sub {
    font-size: clamp(1rem, 2vw, 1.0625rem);
    color: var(--text-3);
    line-height: 1.75;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .country-sub strong { color: var(--text-2); font-weight: 500; }

  .country-highlights {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .hl-val {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    font-family: 'Sora', sans-serif;
    line-height: 1;
  }

  .hl-label {
    font-size: 0.6875rem;
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .hl-sep {
    width: 1px;
    height: 2rem;
    background: var(--border);
    flex-shrink: 0;
  }

  .tool-section { padding: 0 0 2rem; }

  .tool-shell {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface);
    min-height: 640px;
    display: flex;
    flex-direction: column;
  }

  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
