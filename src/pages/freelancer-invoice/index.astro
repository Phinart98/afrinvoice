---
import DocToolPage from '../../components/DocToolPage.astro';
import type { FaqItem } from '../../components/FaqSection.astro';

const faqs: FaqItem[] = [
  { q: 'How do freelancers invoice foreign clients?',
    a: 'Invoice in the client’s currency (USD, EUR, GBP…) and, if they prefer, in their language. Add your payment method, such as an IBAN, a Wise or PayPal link, or local bank details, and state that the service is exported if your country zero-rates it.' },
  { q: 'Do I need to charge VAT or GST as a freelancer?',
    a: 'Only if you are registered, or above your country’s registration threshold. Exports of services to foreign businesses are often zero-rated or reverse-charged. Each country page explains the threshold and the note to add.' },
  { q: 'What about withholding tax?',
    a: 'In Spain (IRPF), Italy (ritenuta d’acconto), Nigeria and Kenya (WHT), business clients deduct tax from what they pay you. Pick the preset for your country and the invoice shows the net amount you will receive.' },
  { q: 'Can I bill by the hour?',
    a: 'Yes. Rename the item column to Hours or Task, enter hours as the quantity and your rate as the price. Quantities can be decimals such as 7.5.' },
];
---

<DocToolPage
  path="/freelancer-invoice/"
  title="Free Freelancer Invoice Generator — Bill Clients Worldwide"
  description="Invoice clients anywhere as a freelancer: hourly rates, any currency, withholding tax (IRPF, WHT), VAT reverse charge notes and payment links. Free PDF, no sign-up."
  badge="Hourly or fixed · Any currency · Get paid online"
  heading="Freelancer Invoice Generator"
  sub="Bill local and foreign clients properly: <strong>hourly rates, any currency, withholding tax and reverse-charge notes</strong>, plus a payment link your client can scan."
  faqs={faqs}
>
  <h2>A freelancer invoice checklist</h2>
  <ul>
    <li>Your name or trading name, address and tax ID if registered</li>
    <li>The client’s legal name and address</li>
    <li>A unique invoice number and the date you finished the work</li>
    <li>Each task or block of hours with the rate</li>
    <li>Tax lines, or the exemption/reverse-charge note that explains why there is no tax</li>
    <li>Payment terms (Net 14 or Net 30) and exactly how to pay you</li>
  </ul>
  <p>Invoicing the same clients every month? Download once, then use <strong>History → Duplicate</strong> next month.</p>
</DocToolPage>
