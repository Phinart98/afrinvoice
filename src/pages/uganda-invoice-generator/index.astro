---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/uganda-invoice-generator/';
const schema   = webAppSchema(
  'Uganda Invoice Generator — URA VAT 18% Pre-filled',
  pageUrl,
  'Create professional Uganda invoices with URA VAT 18% auto-filled. MTN MoMo and Airtel Money payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Uganda Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Uganda invoice generator auto-fill URA VAT?',
    a: 'Yes. Uganda Revenue Authority (URA) VAT at <strong>18%</strong> is pre-filled when you select Uganda. This is one of the higher VAT rates in East Africa. The rate is editable for exempt or zero-rated supplies.',
  },
  {
    q: 'Can I add MTN MoMo payment instructions to my Uganda invoice?',
    a: 'Yes. Uganda defaults to Mobile Money with MTN MoMo pre-selected. Airtel Money is also available in the dropdown. Enter your number in the format 077XXXXXXX.',
  },
  {
    q: 'What currency does the Uganda invoice use?',
    a: 'Uganda Shilling (USh / UGX). All amounts — subtotal, URA VAT 18%, and total — display in USh.',
  },
  {
    q: 'What Withholding Tax (WHT) rate applies in Uganda?',
    a: 'WHT in Uganda is typically 6% on payments to resident contractors and 15% on payments to non-residents. It\'s usually deducted by the payer (your client). Note this in the invoice Notes field if relevant.',
  },
];
---

<Base
  title="Uganda Invoice Generator — URA VAT 18%"
  description="Create Uganda invoices with URA VAT 18% pre-filled. MTN MoMo and Airtel Money payment instructions. Free PDF download, no sign-up."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="ug-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Uganda Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇺🇬</span> Uganda · UGX · URA VAT 18%</div>
      <h1 id="ug-heading" class="country-heading">
        Uganda Invoice Generator<br />
        <span class="shimmer">with URA VAT auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Uganda: <strong>USh currency</strong>, <strong>URA VAT 18%</strong>, and <strong>MTN MoMo</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">18%</span><span class="hl-label">URA VAT rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">USh</span><span class="hl-label">Uganda Shilling</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">MoMo</span><span class="hl-label">MTN · Airtel Money</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Uganda invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="uganda" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/" class="guide-link">Browse all African invoice generators →</a>
  </div>

  <section class="section" aria-labelledby="ug-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Uganda Invoice Generator — FAQs" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
