---
import Base from '../../layouts/Base.astro';
import FaqSection from '../../components/FaqSection.astro';
import type { FaqItem } from '../../components/FaqSection.astro';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';
import { SITE, abs } from '../../site';

const pageUrl = abs('/invoice-number-format/');
const description = 'How to number invoices: sequential, year-based and prefixed formats with examples, what tax authorities in the EU, UK, India and elsewhere require, and how to handle a cancelled invoice.';

// What the law says about numbering, where it says something specific.
const rules = [
  { where: 'European Union', rule: 'A sequential number, in one or more series, that identifies the invoice uniquely (VAT Directive, Article 226).' },
  { where: 'France', rule: 'One continuous, chronological sequence with no gaps. Separate series are allowed if each one is continuous.' },
  { where: 'Germany', rule: 'A unique number in one or more series. It doesn’t have to be gapless, but you should be able to explain a gap.' },
  { where: 'Spain', rule: 'A correlative number within each series. Corrective invoices (facturas rectificativas) go in a series of their own.' },
  { where: 'United Kingdom', rule: 'A unique sequential number on every VAT invoice.' },
  { where: 'India', rule: 'At most 16 characters (letters, numbers, hyphens and slashes), unique within each financial year.' },
  { where: 'United States', rule: 'No federal rule. A unique number is still what clients’ accounts payable teams expect.' },
];

const faqs: FaqItem[] = [
  { q: 'Can I reuse an invoice number?',
    a: 'No. Every number must be unique, including numbers on invoices you later cancelled. Reusing one makes two documents look like the same invoice, which confuses your client’s accounts and your own.' },
  { q: 'How do I cancel an invoice I already sent?',
    a: 'Don’t delete it or reuse its number. Issue a <a href="/credit-note/">credit note</a> that refers to the original invoice number, so the cancellation is on the record.' },
  { q: 'Should the year be in my invoice number?',
    a: 'It helps if you send a lot of invoices, because INV-2026-0001 makes each year easy to file. If you send a few a month, INV-0001 counting up for ever is simpler and just as valid.' },
  { q: `How does ${SITE.name} number invoices?`,
    a: 'Each country starts with a short prefix, such as DE-0001 or IN-0001, and quotes, proformas, receipts and credit notes keep their own counters (Q-, PF-, R- and CN-). The counter moves on only when you download or print, and you can type any number you like instead.' },
];
---

<Base
  title="Invoice Number Format: Examples and Rules by Country"
  description={description}
  schema={[
    articleSchema('Invoice number format: examples and rules by country', pageUrl, description, '2026-10-21'),
    breadcrumbSchema([{ name: SITE.name, url: abs('/') }, { name: 'Invoice numbers', url: pageUrl }]),
    faqSchema(faqs),
  ]}
>
  <article class="article container-narrow" aria-labelledby="guide-heading">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a><span aria-hidden="true">›</span><span aria-current="page">Invoice numbers</span>
    </nav>
    <h1 id="guide-heading">How to number your invoices</h1>
    <p class="lead">Every invoice needs a number that no other invoice of yours has. Beyond that, most countries let you choose the format, so pick one that is easy to sort and stick to it. Here are the common formats, and the few places where the law asks for something more specific.</p>

    <h2>Common formats</h2>
    <h3>A plain running number</h3>
    <p class="example"><span>INV-0001</span><span>INV-0002</span><span>INV-0003</span></p>
    <p>The simplest choice and a good default for freelancers. Pad it to four digits so 0010 sorts after 0009 in a folder or spreadsheet.</p>

    <h3>Year and number</h3>
    <p class="example"><span>2026-0001</span><span>INV-2026-0042</span></p>
    <p>Useful once you send dozens of invoices a year, because each year’s invoices file together. If your country requires one unbroken sequence, as France does, keep counting across the new year or treat each year as its own clearly named series.</p>

    <h3>A separate series for each kind of document</h3>
    <p class="example"><span>INV-0001</span><span>Q-0001</span><span>CN-0001</span></p>
    <p>Quotes and proformas are not invoices, so giving them their own prefix keeps your invoice sequence clean. Credit notes get their own series too, and Spain requires that for corrective invoices.</p>

    <h3>Client or project prefixes</h3>
    <p class="example"><span>ACME-001</span><span>ACME-002</span></p>
    <p>Handy for agencies with a few long-running clients. Check that your country allows several series first, because each prefix starts a new one.</p>

    <h2>What the law asks for</h2>
    <p>Where tax rules mention invoice numbers at all, they ask for uniqueness and a sequence you can follow. A few go further:</p>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>Where</th><th>Numbering rule</th></tr></thead>
        <tbody>{rules.map(r => <tr><td>{r.where}</td><td>{r.rule}</td></tr>)}</tbody>
      </table>
    </div>
    <p>Each <a href="/invoice-requirements-by-country/">country page</a> lists everything else an invoice there must show.</p>

    <h2>Habits that keep you out of trouble</h2>
    <ul>
      <li>Never reuse a number, even from an invoice you cancelled.</li>
      <li>Cancel or correct an invoice with a credit note instead of deleting it.</li>
      <li>Avoid gaps. If one happens, keep a note of why, such as a test invoice you never sent.</li>
      <li>Pick one format and use it for every client, so your records sort in order.</li>
    </ul>

    <div class="cta">
      <a href="/" class="btn btn-primary">Make an invoice</a>
      <p>The number counts up on its own each time you download, and you can change it whenever you like.</p>
    </div>
  </article>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Questions about invoice numbers" headingId="faq-heading" />
    </div>
  </section>
</Base>
