---
import Base from '../layouts/Base.astro';
import AdUnit from '../components/AdUnit.astro';
import FaqSection from '../components/FaqSection.astro';
import AffiliateCallout from '../components/AffiliateCallout.astro';
import InvoiceGenerator from '../components/InvoiceGenerator.vue';
import { COUNTRIES, COUNTRY_BY_KEY, countryPath, type CountryConfig } from '../data/countries';
import { checkedSpan } from '../utils/stamp';
import { webAppSchema, faqSchema } from '../utils/schema';
import { SITE } from '../site';
import type { FaqItem } from '../components/FaqSection.astro';

const schema = webAppSchema(
  `${SITE.name} — Free Invoice Generator`,
  SITE.url,
  'Free invoice, quote and receipt generator with country tax presets (VAT, GST, sales tax, withholding), any currency, payment QR codes and 7 invoice languages. No sign-up, instant PDF.',
);

// "What changes when you pick a country": five contrasting countries, read straight from the data
const langName = new Intl.DisplayNames(['en'], { type: 'language' });
const railName = (c: CountryConfig) => ({
  bank: 'Bank transfer',
  iban: 'IBAN, with a SEPA QR code',
  'mobile-money': c.mobileProviders?.length ? c.mobileProviders.slice(0, 2).map(p => p.name).join(' or ') : 'Mobile money',
  upi: 'UPI, with a QR code',
})[c.rails[0]];
const compared = ['germany', 'france', 'india', 'united-states', 'ghana'].map(k => COUNTRY_BY_KEY[k]).map(c => ({
  c,
  tax: c.taxPresets[0]?.label ?? 'No tax',
  paper: c.paper === 'Letter' ? 'US Letter' : 'A4',
  pay: railName(c),
  lang: langName.of(c.labelsLang) ?? c.labelsLang,
}));
const checked = checkedSpan(COUNTRIES.map(c => c.lastVerified));

const faqs: FaqItem[] = [
  { q: `Is ${SITE.name} really free?`,
    a: 'Yes. No account, no watermark, no limits and no trial. The PDF is created in your browser, so your invoices never touch our servers.' },
  { q: 'Which countries are supported?',
    a: `${COUNTRIES.length} countries have tax presets, required-field checklists and local payment methods built in, including the US, UK, Canada, Australia, India, Germany, France, Spain, Italy, the UAE, Nigeria, Ghana, Kenya and South Africa. Anywhere else, choose Other country and set your own tax.` },
  { q: 'Can I charge more than one tax, or withhold tax?',
    a: 'Yes. Add as many tax lines as you need (for example CGST + SGST, or GST + QST), mark a line as withheld to subtract it (IRPF, ritenuta d’acconto, WHT), and tick prices already include tax if your prices are tax-inclusive.' },
  { q: 'Can I invoice a foreign client in their currency?',
    a: 'Yes. Pick any currency and any of 7 invoice languages. Amounts, dates and labels are formatted the way your client expects.' },
  { q: 'Is a PDF invoice legally valid?',
    a: 'In most countries, yes, as long as it has the required details, which each country page lists. A few countries now require e-invoices through a government system for domestic sales (Italy and Côte d’Ivoire, for example), and the country pages say so plainly.' },
  { q: 'Where is my data stored?',
    a: 'Only in your browser. Clearing your browser data removes it, so use Export backup in the History panel to keep a copy or move to another device.' },
];

const pageTitle = `Free Invoice Generator with VAT, GST & Sales Tax Built In — ${SITE.name}`;
const pageDescription = `Free invoice generator that knows your country’s rules: VAT, GST, sales tax and withholding presets for ${COUNTRIES.length} countries, any currency, payment QR codes, quotes and receipts. No sign-up, instant PDF.`;
---

<Base title={pageTitle} description={pageDescription} schema={[schema, faqSchema(faqs)]}>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-row">
      <div class="hero-text">
        <h1 id="hero-heading" class="hero-heading">A free invoice generator that knows your country’s rules</h1>
        <p class="hero-sub hero-links">
          Pick your country and the taxes, currency, paper size and payment details set themselves up.
          It’s ready for <a href={countryPath(COUNTRY_BY_KEY['germany'])}>Germany</a>,
          <a href={countryPath(COUNTRY_BY_KEY['india'])}>India</a>,
          <a href={countryPath(COUNTRY_BY_KEY['ghana'])}>Ghana</a>,
          <a href={countryPath(COUNTRY_BY_KEY['united-kingdom'])}>the UK</a>,
          <a href={countryPath(COUNTRY_BY_KEY['united-states'])}>the US</a> and
          <a href="/invoice-requirements-by-country/">{COUNTRIES.length - 5} more countries</a>.
        </p>
      </div>
      <nav class="sheet-fan" aria-label="Documents you can make">
        <a class="sheet sheet-credit" href="/credit-note/">Credit note</a>
        <a class="sheet sheet-proforma" href="/proforma-invoice/">Proforma invoice</a>
        <a class="sheet sheet-receipt" href="/receipt-generator/">Receipt</a>
        <a class="sheet sheet-quote" href="/quote-generator/">Quote</a>
        <a class="sheet sheet-invoice" href="#main-content">Invoice<small>Rules for {COUNTRIES.length} countries, checked {checked}</small><span class="sheet-no">No. 0001</span></a>
      </nav>
    </div>
  </section>

  <section class="tool-section" aria-label="Invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <section class="features section" aria-labelledby="features-heading">
    <div class="container">
      <h2 id="features-heading" class="features-heading">What changes when you pick a country</h2>
      <p class="features-lead">A few examples. Every rate can be edited, and you can add tax lines, withholding, discounts and shipping.</p>
      <table class="compare">
        <thead>
          <tr><th scope="col">Country</th><th scope="col">Tax on the invoice</th><th scope="col">Tax ID</th><th scope="col">Paper</th><th scope="col">Clients pay by</th><th scope="col">Printed in</th></tr>
        </thead>
        <tbody>
          {compared.map(r => (
            <tr>
              <th scope="row"><a href={countryPath(r.c)}>{r.c.name}</a></th>
              <td data-label="Tax on the invoice">{r.tax}</td>
              <td data-label="Tax ID">{r.c.taxIdLabel}</td>
              <td data-label="Paper">{r.paper}</td>
              <td data-label="Clients pay by">{r.pay}</td>
              <td data-label="Printed in">{r.lang}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="features-more">
        The same form makes quotes, receipts, proformas and credit notes, in any currency and in seven languages.
        Nothing you type is uploaded: your details, clients and invoice history stay in this browser, and
        Export backup moves them to another device.
      </p>
    </div>
  </section>

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Frequently asked questions" headingId="faq-heading" />
    </div>
  </section>
</Base>

<style>
  /* ── Hero: left-aligned, the stamp on the right; the tool starts right after ── */
  .hero { padding: 3.5rem 0 2.5rem; }

  .hero-heading {
    font-size: clamp(2rem, 5vw, 3.05rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 18em;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.65;
    max-width: 40rem;
  }

  /* ── Comparison table ─────────────────────────────── */
  .features-heading { margin-bottom: 0.5rem; }
  .features-lead { margin-bottom: 1.5rem; max-width: 40rem; }
  .features-more { margin-top: 1.5rem; max-width: 44rem; }

  .compare {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    font-size: 0.9375rem;
  }
  .compare th, .compare td {
    text-align: left;
    vertical-align: top;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .compare thead th { font-size: 0.8125rem; font-weight: 700; }
  .compare tbody th { font-weight: 700; white-space: nowrap; }
  .compare tbody th a { color: var(--text); }
  .compare tbody th a:hover { color: var(--accent); }
  .compare td { color: var(--text-2); }
  .compare tr:last-child > * { border-bottom: none; }

  /* Phones: each country becomes a small labelled block */
  @media (max-width: 760px) {
    .compare, .compare tbody, .compare tr, .compare th, .compare td { display: block; }
    .compare thead { display: none; }
    .compare tr { padding: 0.875rem 1rem; border-bottom: 1px solid var(--border); }
    .compare tr:last-child { border-bottom: none; }
    .compare th, .compare td { padding: 0; border: none; }
    .compare tbody th { font-size: 1.0625rem; margin-bottom: 0.375rem; }
    .compare td { display: grid; grid-template-columns: 8.5rem 1fr; gap: 0.75rem; padding: 0.1875rem 0; }
    .compare td::before { content: attr(data-label); color: var(--text-4); font-size: 0.8125rem; }
  }

  .affiliate-wrap {
    padding-top: 0.5rem;
    padding-bottom: 1rem;
  }
</style>
