---
import Base from '../layouts/Base.astro';
import AdUnit from '../components/AdUnit.astro';
import FaqSection from '../components/FaqSection.astro';
import AffiliateCallout from '../components/AffiliateCallout.astro';
import InvoiceGenerator from '../components/InvoiceGenerator.vue';
import { COUNTRIES, FEATURED_COUNTRIES, countryPath } from '../data/countries';
import { webAppSchema, faqSchema } from '../utils/schema';
import { SITE } from '../site';
import type { FaqItem } from '../components/FaqSection.astro';

const schema = webAppSchema(
  `${SITE.name} — Free Invoice Generator`,
  SITE.url,
  'Free invoice, quote and receipt generator with country tax presets (VAT, GST, sales tax, withholding), any currency, payment QR codes and 7 invoice languages. No sign-up, instant PDF.',
);

const icon = (d: string) => `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#0F766E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const features = [
  { icon: icon('<circle cx="10" cy="10" r="8"/><path d="M2 10h16M10 2a12 12 0 010 16M10 2a12 12 0 000 16"/>'),
    title: `Knows the rules in ${COUNTRIES.length} countries`,
    body: 'UK VAT, Canadian GST/HST by province, India CGST + SGST, Australian GST, EU VAT with reverse charge, Spanish IRPF, Ghana levies: set up in one click, every rate editable.' },
  { icon: icon('<path d="M4 6h12M4 10h12M4 14h7"/><path d="M14 13l2 2 3-3"/>'),
    title: 'Everything a real invoice needs',
    body: 'Several tax lines, tax-inclusive prices, withholding, discounts, shipping, part-payments and balance due. Quotes, receipts, proformas and credit notes too.' },
  { icon: icon('<rect x="3" y="3" width="5" height="5"/><rect x="12" y="3" width="5" height="5"/><rect x="3" y="12" width="5" height="5"/><path d="M12 12h2v2h-2zM15 15h2v2h-2z"/>'),
    title: 'Get paid faster',
    body: 'IBAN with a SEPA QR code any European banking app can scan, a UPI QR for India, mobile money in Africa, or your PayPal, Stripe or Wise link as a QR code.' },
  { icon: icon('<path d="M4 4h9l3 3v9H4z"/><path d="M7 10h6M7 13h4"/>'),
    title: 'Speaks your client’s language',
    body: 'Print the invoice in English, French, German, Spanish, Portuguese, Italian or Dutch, with local number and date formats on A4 or US Letter.' },
  { icon: icon('<rect x="4" y="9" width="12" height="8" rx="1.5"/><path d="M7 9V6a3 3 0 016 0v3"/>'),
    title: 'Private by design',
    body: 'No account and no upload. Your business details, clients and invoice history stay in your browser. Export a backup whenever you like.' },
  { icon: icon('<path d="M4 4h12v12H4z"/><path d="M4 8h12M8 8v8"/>'),
    title: '3 clean templates, no watermark',
    body: 'Minimal, Modern and Classic, with your logo and colours. Every currency symbol prints correctly: ₦, ₹, ₵, € and the rest.' },
];

const faqs: FaqItem[] = [
  { q: `Is ${SITE.name} really free?`,
    a: 'Yes. No account, no watermark, no limits and no trial. The PDF is created in your browser, so your invoices never touch our servers.' },
  { q: 'Which countries are supported?',
    a: `${COUNTRIES.length} countries have tax presets, required-field checklists and local payment methods built in, including the US, UK, Canada, Australia, India, Germany, France, Spain, Italy, the UAE, Nigeria, Ghana, Kenya and South Africa. Anywhere else, choose Other country and set your own tax.` },
  { q: 'Can I charge more than one tax, or withhold tax?',
    a: 'Yes. Add as many tax lines as you need (for example CGST + SGST, or GST + QST), mark a line as withheld to subtract it (IRPF, ritenuta d’acconto, WHT), and tick prices already include tax if your prices are tax-inclusive.' },
  { q: 'Can I invoice a foreign client in their currency?',
    a: 'Yes. Pick any currency and any of 7 invoice languages. Amounts, dates and labels are formatted the way your client expects.' },
  { q: 'Is a PDF invoice legally valid?',
    a: 'In most countries, yes, as long as it has the required details, which each country page lists. A few countries now require e-invoices through a government system for domestic sales (Italy and Côte d’Ivoire, for example), and the country pages say so plainly.' },
  { q: 'Where is my data stored?',
    a: 'Only in your browser. Clearing your browser data removes it, so use Export backup in the History panel to keep a copy or move to another device.' },
];

const pageTitle = `Free Invoice Generator with VAT, GST & Sales Tax Built In — ${SITE.name}`;
const pageDescription = `Free invoice generator that knows your country’s rules: VAT, GST, sales tax and withholding presets for ${COUNTRIES.length} countries, any currency, payment QR codes, quotes and receipts. No sign-up, instant PDF.`;
const moreCount = COUNTRIES.length - FEATURED_COUNTRIES.length;
---

<Base title={pageTitle} description={pageDescription} schema={[schema, faqSchema(faqs)]}>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge anim-fade-up anim-delay-1">Free · No sign-up · Nothing uploaded</div>
        <h1 id="hero-heading" class="hero-heading anim-fade-up anim-delay-2">
          The free invoice generator<br />
          <span class="shimmer">that knows your country’s rules.</span>
        </h1>
        <p class="hero-sub anim-fade-up anim-delay-3">
          Pick your country and the right taxes, currency, paper size and payment details set themselves up.
          <strong>Download a professional PDF in under a minute.</strong>
        </p>
        <div class="hero-chips anim-fade-up anim-delay-4" role="list" aria-label="Country invoice generators">
          {FEATURED_COUNTRIES.map(c => (
            <a href={countryPath(c)} class="country-chip" role="listitem"><span aria-hidden="true">{c.flag}</span> {c.name}</a>
          ))}
          <a href="/invoice-requirements-by-country/" class="country-chip" role="listitem">+ {moreCount} more</a>
        </div>
        <div class="hero-stats anim-fade-up anim-delay-5">
          <div class="hero-stat"><span class="hero-stat-num mono">{COUNTRIES.length}</span><span class="hero-stat-label">countries</span></div>
          <div class="hero-stat-sep" aria-hidden="true"></div>
          <div class="hero-stat"><span class="hero-stat-num mono">7</span><span class="hero-stat-label">invoice languages</span></div>
          <div class="hero-stat-sep" aria-hidden="true"></div>
          <div class="hero-stat"><span class="hero-stat-num mono">100%</span><span class="hero-stat-label">in your browser</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <section class="features section" aria-labelledby="features-heading">
    <div class="container">
      <h2 id="features-heading" class="features-heading">Everything you need to get paid, nothing you don’t</h2>
      <div class="features-grid">
        {features.map(f => (
          <div class="feature-card">
            <div class="feature-icon" set:html={f.icon} aria-hidden="true" />
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Frequently asked questions" headingId="faq-heading" />
    </div>
  </section>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: 6rem 0 4rem;
    overflow: hidden;
    text-align: center;
  }


  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.625rem;
    max-width: 52rem;
    margin: 0 auto;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.875rem;
    background: rgba(15, 118, 110, 0.06);
    border: 1px solid rgba(15, 118, 110, 0.18);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #0F766E;
    letter-spacing: 0.01em;
  }

  /* Headline */
  .hero-heading {
    font-size: clamp(2.125rem, 6vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  /* Subtext */
  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--text-3);
    line-height: 1.75;
    max-width: 38rem;
  }
  .hero-sub strong {
    color: var(--text-2);
    font-weight: 500;
  }

  /* Country chips */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  /* Stats strip */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .hero-stat-num {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1;
  }

  .hero-stat-label {
    font-size: 0.7rem;
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  @media (max-width: 400px) {
    .hero-stats    { gap: 0.875rem; }
    .hero-stat-num { font-size: 1.125rem; }
    .hero-stat-label { font-size: 0.6rem; letter-spacing: 0.03em; }
    .hero-stat-sep { height: 1.5rem; }
  }

  .hero-stat-sep {
    width: 1px;
    height: 2rem;
    background: var(--border);
    flex-shrink: 0;
  }

  /* ── Tool section ─────────────────────────────────── */
  .tool-section {
    padding: 0 0 2rem;
  }

  /* Shell that gives the Vue island its border/radius and enforces height */
  .tool-shell {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface);
    min-height: 640px;
    display: flex;
    flex-direction: column;
  }

  /* ── Features ─────────────────────────────────────── */
  .features-heading {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .features-grid { grid-template-columns: 1fr 1fr; }
  }

  .feature-card {
    background: var(--surface);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transition: background var(--ease);
  }
  .feature-card:hover { background: var(--surface-2); }

  .feature-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-subtle);
    border: 1px solid rgba(15, 118, 110, 0.15);
    border-radius: 8px;
    margin-bottom: 0.25rem;
  }

  .feature-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .feature-body {
    font-size: 0.875rem;
    color: var(--text-3);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Affiliate wrap ───────────────────────────────── */
  .affiliate-wrap {
    padding-top: 0.5rem;
    padding-bottom: 1rem;
  }
</style>
