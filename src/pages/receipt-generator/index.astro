---
import DocToolPage from '../../components/DocToolPage.astro';
import type { FaqItem } from '../../components/FaqSection.astro';

const faqs: FaqItem[] = [
  { q: 'What is the difference between an invoice and a receipt?',
    a: 'An invoice asks to be paid; a receipt confirms you have been paid. Send the receipt after the money arrives, showing the date and how it was paid.' },
  { q: 'How do I show that a receipt is fully paid?',
    a: 'Enter the amount received in Amount paid. The receipt prints the amount paid and a balance due of zero, or the remaining balance for a part-payment.' },
  { q: 'Can I record how the customer paid?',
    a: 'Yes. Add it in Notes, for example Paid by bank transfer on 3 March, ref 88213, or by mobile money, card or cash.' },
  { q: 'Is this a tax receipt?',
    a: 'It shows the tax included in the payment when you pick a tax setup. Some countries require receipts from registered fiscal devices or e-invoicing systems; your country page says if that applies.' },
];
---

<DocToolPage
  path="/receipt-generator/"
  title="Free Receipt Generator for Printable PDF Receipts"
  description="Create a payment receipt in seconds: amount paid, balance due, tax, payment method and your logo. Any currency, free PDF, no sign-up."
  heading="Receipt generator"
  sub="Confirm a payment with a clean <strong>PDF receipt</strong>: what was paid, when, how, and any balance still due."
  docPreset="receipt"
  faqs={faqs}
>
  <h2>What a good receipt shows</h2>
  <ul>
    <li>Receipt number and payment date</li>
    <li>Who paid, and who was paid</li>
    <li>What the payment was for</li>
    <li>Amount paid, tax included and any balance still due</li>
    <li>Payment method and reference</li>
  </ul>
</DocToolPage>
