---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/ivory-coast-invoice-generator/';
const schema   = webAppSchema(
  "Ivory Coast Invoice Generator — TVA 18% Pre-filled",
  pageUrl,
  "Create professional Côte d'Ivoire invoices with DGI TVA 18% auto-filled. Orange Money and Wave payment instructions. Free PDF, no sign-up.",
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: "Ivory Coast Invoice Generator", url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: "Does this Côte d'Ivoire invoice generator auto-fill TVA?",
    a: "Yes. The Direction Générale des Impôts (DGI) TVA at <strong>18%</strong> is pre-filled when you select Ivory Coast. This is the standard UEMOA-aligned rate across most Francophone West African countries.",
  },
  {
    q: 'Which mobile money provider is most popular in Côte d\'Ivoire?',
    a: "<strong>Orange Money</strong> is the market leader in Côte d'Ivoire with the largest user base. Wave has grown rapidly due to its zero-fee model and is now a major player alongside MTN MoMo and Moov Money. Orange Money uses the 07 prefix; MTN MoMo uses 05. All four providers are listed in this tool.",
  },
  {
    q: 'What currency does the Ivory Coast invoice use?',
    a: "West African CFA Franc (XOF), displayed as <strong>FCFA</strong>. The CFA Franc is shared by eight UEMOA member states including Côte d'Ivoire, Senegal, and Mali. It is pegged to the Euro.",
  },
  {
    q: "Can I invoice international clients in USD from Côte d'Ivoire?",
    a: "Yes. Many Ivorian tech professionals and consultants invoice in USD or EUR. Change the currency to USD in the tool, set TVA to 0% for qualifying export services, and include your Wise or bank transfer details.",
  },
];
---

<Base
  title="Ivory Coast Invoice Generator — DGI TVA 18%"
  description="Create Côte d'Ivoire invoices with DGI TVA 18% pre-filled. Orange Money and Wave payment instructions included. Free PDF download, no sign-up required."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="ci-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Ivory Coast Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇨🇮</span> Côte d'Ivoire · XOF · TVA 18%</div>
      <h1 id="ci-heading" class="country-heading">
        Ivory Coast Invoice Generator<br />
        <span class="shimmer">with DGI TVA auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Ivory Coast: <strong>FCFA currency</strong>, <strong>TVA 18%</strong>, and <strong>Orange Money</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">18%</span><span class="hl-label">DGI TVA rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">FCFA</span><span class="hl-label">CFA Franc (XOF)</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">Orange</span><span class="hl-label">Orange · MTN · Wave</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Ivory Coast invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="ivory-coast" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/mobile-money-invoice/" class="guide-link">Invoice with mobile money payment fields →</a>
  </div>

  <section class="section" aria-labelledby="ci-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Ivory Coast Invoice Generator — FAQs" headingId="ci-faq-heading" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
