---
import Base from '../../layouts/Base.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl   = 'https://afrinvoice.app/how-to-invoice-kenya/';
const schema    = articleSchema(
  'How to Invoice Clients in Kenya — KRA VAT Guide',
  pageUrl,
  'Complete guide to invoicing clients in Kenya. KRA VAT 16%, M-Pesa payment instructions, eTIMS e-invoicing, invoice number formats, and a free invoice generator.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'How to Invoice Clients in Kenya', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'What is the KRA VAT rate in Kenya?',
    a: 'Kenya Revenue Authority (KRA) VAT is <strong>16%</strong> — one of the higher rates in East Africa. You must register for VAT once your annual taxable turnover exceeds <strong>KSh 5 million</strong>.',
  },
  {
    q: 'What is KRA eTIMS and do I need it?',
    a: 'eTIMS (Electronic Tax Invoice Management System) is KRA\'s mandatory e-invoicing system for VAT-registered taxpayers. If you are VAT-registered, you must generate and transmit invoices through eTIMS or a certified third-party system. Non-VAT-registered freelancers and small businesses do not need eTIMS — a professional PDF invoice like those generated by this tool is sufficient.',
  },
  {
    q: 'Can I include M-Pesa payment details on my Kenya invoice?',
    a: 'Yes. M-Pesa is the dominant payment method in Kenya for B2B transactions under KSh 70,000. Include your Safaricom number (07XXXXXXXX) and account name. For larger amounts, bank transfer (Pesalink/RTGS) is preferred.',
  },
  {
    q: 'How do I invoice international clients from Kenya in USD?',
    a: 'Select Kenya for your defaults (KRA context, invoicePrefix KE-), then change the currency symbol to $ and code to USD. Set tax to 0% for exported services. Provide your Wise, Payoneer, or USD bank account details in the payment section.',
  },
];
---

<Base
  title="How to Invoice in Kenya — KRA VAT Guide"
  description="Complete guide to invoicing clients in Kenya. KRA VAT 16%, M-Pesa payment instructions, eTIMS e-invoicing explained, due dates, and a free invoice generator."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <article class="guide-wrap" aria-labelledby="guide-heading">
    <div class="container-narrow">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">How to Invoice Clients in Kenya</span>
      </nav>

      <header class="guide-header">
        <div class="guide-badge">🇰🇪 Kenya · KRA VAT 16% · M-Pesa</div>
        <h1 id="guide-heading" class="guide-heading">How to Invoice Clients in Kenya</h1>
        <p class="guide-lead">
          Kenya has a well-developed invoicing culture and strong mobile payment infrastructure.
          M-Pesa dominates, KRA VAT is 16%, and the KRA eTIMS system is mandatory for VAT-registered
          businesses. Here's what you need to know.
        </p>
      </header>

      <section class="guide-section">
        <h2>What must appear on a Kenya invoice?</h2>
        <ul>
          <li><strong>Your name or business name</strong> and contact details</li>
          <li><strong>Client name and address</strong></li>
          <li><strong>Invoice number</strong> — e.g. KE-0001 (sequential)</li>
          <li><strong>Invoice date and due date</strong></li>
          <li><strong>Itemised services</strong> in KSh (Kenya Shilling)</li>
          <li><strong>KRA VAT 16%</strong> — only if VAT-registered (threshold: KSh 5 million/year)</li>
          <li><strong>Grand total</strong></li>
          <li><strong>Payment method</strong> — M-Pesa number, bank account, or Pesalink details</li>
        </ul>
      </section>

      <section class="guide-section">
        <h2>KRA VAT — when to charge it</h2>
        <p>
          Kenya Revenue Authority (KRA) VAT is <strong>16%</strong>. You must register for VAT when
          your annual taxable turnover exceeds <strong>KSh 5 million</strong> (approximately $38,500 USD).
        </p>
        <p>
          Common exemptions and zero-rating: agricultural inputs, financial services, educational services,
          and exported services to non-resident clients. If you export services — e.g. working for
          international clients remotely — the supply may be zero-rated.
        </p>
      </section>

      <section class="guide-section">
        <h2>KRA eTIMS — do you need it?</h2>
        <p>
          KRA's Electronic Tax Invoice Management System (eTIMS) is mandatory for
          <strong>VAT-registered taxpayers</strong>. If you're VAT-registered, you must issue invoices
          through eTIMS or a KRA-approved third-party system.
        </p>
        <p>
          <strong>Not VAT-registered?</strong> You do not need eTIMS. A professional PDF invoice
          issued through this tool is sufficient for non-VAT-registered freelancers and small businesses.
        </p>
        <div class="guide-callout">
          KRA eTIMS registration: itax.kra.go.ke → eTIMS portal. You'll need your KRA PIN and business details.
        </div>
      </section>

      <section class="guide-section">
        <h2>M-Pesa and mobile money payment instructions</h2>
        <p>
          M-Pesa (Safaricom) has 34+ million active users in Kenya and handles over $300 billion
          annually. It is widely used for B2B payments up to approximately KSh 70,000 per transaction.
        </p>
        <ul>
          <li><strong>M-Pesa</strong>: Safaricom numbers starting 07XX or 01XX. USSD: *334#</li>
          <li><strong>Airtel Money</strong>: 073X numbers</li>
          <li><strong>Pesalink / RTGS</strong>: For larger B2B amounts (banks direct transfer)</li>
        </ul>
        <p>For M-Pesa Business Pay Bill: include your Pay Bill number and account reference if applicable.</p>
      </section>

      <section class="guide-section">
        <h2>Payment terms</h2>
        <ul>
          <li><strong>Freelancers:</strong> Net 14–21 days, or request 30–50% upfront</li>
          <li><strong>B2B services:</strong> Net 30 days</li>
          <li><strong>NGOs / INGOs:</strong> Net 30–45 days (Nairobi has a large NGO sector)</li>
        </ul>
      </section>

      <div class="guide-cta-wrap">
        <a href="/kenya-invoice-generator/" class="guide-cta">
          Create your Kenya invoice →
        </a>
        <p class="guide-cta-sub">KRA VAT 16% pre-filled · M-Pesa fields · Free PDF</p>
      </div>

    </div>
  </article>

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <section class="section" aria-labelledby="ke-guide-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Kenya Invoicing — FAQs" />
    </div>
  </section>

</Base>

<style>
  .guide-wrap { padding: 3rem 0; }
  .guide-badge { display: inline-block; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1rem; }
  .guide-heading { font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; letter-spacing: -0.025em; color: var(--text); margin-bottom: 1rem; }
  .guide-lead { font-size: 1.0625rem; color: var(--text-3); line-height: 1.75; }
  .guide-section { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  .guide-section h2 { font-size: 1.25rem; font-weight: 700; color: var(--text); letter-spacing: -0.02em; margin-bottom: 0.875rem; }
  .guide-section p { font-size: 0.9375rem; color: var(--text-2); line-height: 1.75; margin-bottom: 0.75rem; }
  .guide-section ul { margin: 0.5rem 0 0.75rem 1.25rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .guide-section li { font-size: 0.9375rem; color: var(--text-2); line-height: 1.65; }
  .guide-callout { margin-top: 1rem; padding: 0.875rem 1rem; background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 0 var(--radius) var(--radius) 0; font-size: 0.875rem; color: var(--text-2); line-height: 1.6; }
  .guide-cta-wrap { margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--border); text-align: center; }
  .guide-cta { display: inline-flex; align-items: center; padding: 0.875rem 2rem; background: #F59E0B; color: #ffffff; font-size: 1rem; font-weight: 700; border-radius: 8px; text-decoration: none; transition: background var(--ease); }
  .guide-cta:hover { background: #D97706; }
  .guide-cta-sub { margin-top: 0.625rem; font-size: 0.8125rem; color: var(--text-4); }
  .affiliate-wrap { padding-top: 2rem; padding-bottom: 1rem; }
</style>
