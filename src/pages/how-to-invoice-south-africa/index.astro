---
import Base from '../../layouts/Base.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';
import { SITE, abs } from '../../site';

const pageUrl   = abs('/how-to-invoice-south-africa/');
const schema    = articleSchema(
  'How to Invoice Clients in South Africa — SARS VAT Guide',
  pageUrl,
  'Complete guide to invoicing clients in South Africa. SARS VAT 15%, bank EFT payment, VAT registration threshold R1 million, invoice number formats, and a free invoice generator.',
);
const breadcrumb = breadcrumbSchema([
  { name: SITE.name, url: abs('/') },
  { name: 'How to Invoice Clients in South Africa', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'What is the SARS VAT rate in South Africa?',
    a: 'South African Revenue Service (SARS) VAT is <strong>15%</strong>. You must register for VAT once your taxable supplies exceed <strong>R 2.3 million</strong> in any 12-month period (effective 1 April 2026). Voluntary registration is allowed from R 120,000.',
  },
  {
    q: 'What payment method should I use on a South Africa B2B invoice?',
    a: '<strong>Bank EFT (Electronic Funds Transfer)</strong> is the standard for all B2B invoicing in South Africa. Include your bank name, account name, account number, and branch code. Instant EFT via PayShap or FNB Pay is increasingly common for same-day payments.',
  },
  {
    q: 'Do I need to include my VAT registration number on every invoice?',
    a: 'Only if you are VAT-registered. If registered, your VAT number must appear on every tax invoice. Non-VAT-registered businesses must not charge VAT — omit the VAT line and do not include a VAT number.',
  },
  {
    q: 'How do I invoice international clients from South Africa in USD?',
    a: 'Select South Africa for your defaults, then change the currency to USD. Exported services to non-resident clients are zero-rated for VAT purposes. Provide your Wise, Payoneer, or USD bank account details. Note "Zero-rated export — VAT 0%" on the invoice.',
  },
];
---

<Base
  title="How to Invoice in South Africa — SARS VAT"
  description="Complete guide to invoicing in South Africa. SARS VAT 15%, bank EFT payment, R1 million VAT threshold, tax invoice requirements, and a free invoice generator."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <article class="guide-wrap" aria-labelledby="guide-heading">
    <div class="container-narrow">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">{SITE.name}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">How to Invoice Clients in South Africa</span>
      </nav>

      <header class="guide-header">
        <h1 id="guide-heading" class="guide-heading">How to Invoice Clients in South Africa</h1>
        <p class="guide-lead">
          South Africa has one of the most structured invoicing environments in Africa.
          SARS VAT is 15%, bank EFT is universal for B2B, and the tax invoice requirements
          are well-defined. Here's everything you need to know.
        </p>
      </header>

      <section class="guide-section">
        <h2>What must appear on a South Africa invoice?</h2>
        <p>SARS distinguishes between a <strong>tax invoice</strong> (VAT-registered) and a regular invoice (non-VAT).</p>
        <p>For VAT-registered businesses, a tax invoice must include:</p>
        <ul>
          <li><strong>The words "Tax Invoice"</strong> — required by law</li>
          <li><strong>Your business name, address, and VAT registration number</strong></li>
          <li><strong>Client name and address</strong></li>
          <li><strong>Unique invoice number</strong> — e.g. ZA-0001 (sequential)</li>
          <li><strong>Invoice date</strong></li>
          <li><strong>Description of goods or services</strong></li>
          <li><strong>Quantity and unit price</strong></li>
          <li><strong>VAT amount (15%)</strong> shown separately</li>
          <li><strong>Total amount including VAT</strong></li>
          <li><strong>Bank details</strong> for payment</li>
        </ul>
        <p>Non-VAT-registered businesses use a standard invoice — omit the VAT line and VAT number.</p>
      </section>

      <section class="guide-section">
        <h2>When to charge SARS VAT</h2>
        <p>
          VAT registration is <strong>mandatory</strong> once your taxable supplies exceed
          <strong>R 2.3 million</strong> in any 12-month period (threshold effective 1 April 2026).
          Voluntary registration is permitted from <strong>R 120,000</strong>.
        </p>
        <p>
          Once registered, you charge 15% VAT on all taxable supplies. Exported services to
          non-resident clients are <strong>zero-rated</strong> — you charge 0% VAT but must
          note this on the invoice.
        </p>
        <div class="guide-callout">
          SARS VAT registration: sars.gov.za → eFiling → VAT registration. You will need your
          income tax number and supporting documents.
        </div>
      </section>

      <section class="guide-section">
        <h2>Bank EFT is how most clients pay</h2>
        <p>
          For all B2B invoicing in South Africa, <strong>bank EFT</strong> is the expected
          payment method. Include:
        </p>
        <ul>
          <li><strong>Bank name</strong> — Absa, FNB, Standard Bank, Nedbank, Capitec</li>
          <li><strong>Account holder name</strong> — must match exactly</li>
          <li><strong>Account number</strong></li>
          <li><strong>Branch code</strong> — or universal branch code (632005 for FNB, 051001 for Absa, etc.)</li>
        </ul>
        <p>
          <strong>PayShap</strong> (instant interbank transfers) is increasingly used for same-day
          payments, especially for amounts under R 3,000. Include your PayShap-linked number if applicable.
        </p>
      </section>

      <section class="guide-section">
        <h2>Payment terms</h2>
        <ul>
          <li><strong>Freelancers:</strong> Net 14–30 days, or 50% deposit upfront</li>
          <li><strong>B2B services:</strong> Net 30 days</li>
          <li><strong>Large corporate / government:</strong> Net 30–60 days (often 60 in practice)</li>
        </ul>
        <p>
          South African corporates are generally reliable payers, but government departments
          can be slow. Build this into your cash flow planning, and always specify your
          payment terms clearly on the invoice.
        </p>
      </section>

      <section class="guide-section">
        <h2>Invoice number format for South Africa</h2>
        <p>No legally mandated format, but the recommended practice:</p>
        <div class="guide-example">
          <code>ZA-0001</code> → <code>ZA-0002</code> → <code>ZA-0003</code>
        </div>
        <p>
          {SITE.name} auto-generates sequential ZA-XXXX numbers and increments on each download.
          You can override the format at any time.
        </p>
      </section>

      <div class="guide-cta-wrap">
        <a href="/south-africa-invoice-generator/" class="guide-cta">
          Create your South Africa invoice
        </a>
        <p class="guide-cta-sub">SARS VAT at 15% is filled in for you, with bank EFT details.</p>
      </div>

    </div>
  </article>

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <section class="section" aria-labelledby="za-guide-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Questions about invoicing in South Africa" headingId="za-guide-faq-heading" />
    </div>
  </section>

</Base>

<style>
  .guide-wrap { padding: 3rem 0; }
  .guide-heading { font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; letter-spacing: -0.025em; color: var(--text); margin-bottom: 1rem; }
  .guide-lead { font-size: 1.0625rem; color: var(--text-3); line-height: 1.75; }
  .guide-section { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  .guide-section h2 { font-size: 1.25rem; font-weight: 700; color: var(--text); letter-spacing: -0.02em; margin-bottom: 0.875rem; }
  .guide-section p { font-size: 0.9375rem; color: var(--text-2); line-height: 1.75; margin-bottom: 0.75rem; }
  .guide-section ul { margin: 0.5rem 0 0.75rem 1.25rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .guide-section li { font-size: 0.9375rem; color: var(--text-2); line-height: 1.65; }
  .guide-callout { margin-top: 1rem; padding: 0.875rem 1rem; background: var(--surface-2); border: none; border-radius: var(--radius); font-size: 0.875rem; color: var(--text-2); line-height: 1.6; }
  .guide-example { margin: 0.5rem 0 0.75rem; padding: 0.75rem 1rem; background: var(--surface-2); border-radius: var(--radius); font-family: var(--font); font-variant-numeric: tabular-nums; font-size: 0.875rem; color: var(--text); display: flex; gap: 1rem; flex-wrap: wrap; }
  .guide-cta-wrap { margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--border); text-align: left; }
  .guide-cta { display: inline-flex; align-items: center; padding: 0.875rem 2rem; background: var(--accent-hover); color: #ffffff; font-size: 1rem; font-weight: 700; border-radius: 8px; text-decoration: none; transition: background var(--ease); }
  .guide-cta:hover { background: var(--accent-hover); color: var(--on-accent); }
  .guide-cta-sub { margin-top: 0.625rem; font-size: 0.8125rem; color: var(--text-4); }
  .affiliate-wrap { padding-top: 2rem; padding-bottom: 1rem; }
</style>
