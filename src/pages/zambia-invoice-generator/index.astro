---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/zambia-invoice-generator/';
const schema   = webAppSchema(
  'Zambia Invoice Generator — ZRA VAT 16% Pre-filled',
  pageUrl,
  'Create professional Zambia invoices with ZRA VAT 16% auto-filled. Airtel Money and MTN MoMo payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Zambia Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Zambia invoice generator auto-fill ZRA VAT?',
    a: 'Yes. Zambia Revenue Authority (ZRA) VAT at <strong>16%</strong> is pre-filled when you select Zambia. The rate is editable for zero-rated or exempt supplies.',
  },
  {
    q: 'Which mobile money provider is most popular in Zambia?',
    a: '<strong>Airtel Money</strong> leads mobile money in Zambia, followed by MTN MoMo. Both are widely accepted. Enter your number in the format 097XXXXXXX for Airtel or 076XXXXXXX for MTN.',
  },
  {
    q: 'What is ZRA e-invoicing and does it affect my invoice?',
    a: 'Zambia launched a Smart Invoice e-invoicing mandate in 2024, requiring VAT-registered businesses to submit invoices through the ZRA Smart Invoice system. This tool generates a compliant paper invoice — VAT-registered users should also file through ZRA Smart Invoice for compliance.',
  },
  {
    q: 'What currency does the Zambia invoice use?',
    a: 'Zambian Kwacha (ZMW), displayed as <strong>K</strong>. All amounts — subtotal, ZRA VAT 16%, and total — appear in Kwacha.',
  },
];
---

<Base
  title="Zambia Invoice Generator — ZRA VAT 16%"
  description="Create Zambia invoices with ZRA VAT 16% pre-filled. Airtel Money and MTN MoMo payment instructions included. Free PDF download, no sign-up required."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="zm-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Zambia Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇿🇲</span> Zambia · ZMW · ZRA VAT 16%</div>
      <h1 id="zm-heading" class="country-heading">
        Zambia Invoice Generator<br />
        <span class="shimmer">with ZRA VAT auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Zambia: <strong>Kwacha currency</strong>, <strong>ZRA VAT 16%</strong>, and <strong>Airtel Money</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">16%</span><span class="hl-label">ZRA VAT rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">K</span><span class="hl-label">Zambian Kwacha</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">Airtel</span><span class="hl-label">Airtel Money · MTN MoMo</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Zambia invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="zambia" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/mobile-money-invoice/" class="guide-link">Invoice with mobile money payment fields →</a>
  </div>

  <section class="section" aria-labelledby="zm-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Zambia Invoice Generator — FAQs" headingId="zm-faq-heading" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
