---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/south-africa-invoice-generator/';
const schema   = webAppSchema(
  'South Africa Invoice Generator — SARS VAT 15% Pre-filled',
  pageUrl,
  'Create professional South Africa invoices with SARS VAT 15% auto-filled. Bank EFT fields included. Free PDF download, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'South Africa Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this South Africa invoice generator auto-fill SARS VAT?',
    a: 'Yes. South African Revenue Service (SARS) VAT at <strong>15%</strong> is pre-filled when you select South Africa. The rate and label are editable — useful if you\'re not VAT-registered (set to 0%) or dealing with zero-rated supplies.',
  },
  {
    q: 'What payment method does the South Africa invoice default to?',
    a: 'Bank EFT (electronic funds transfer) — the standard for all B2B invoicing in South Africa. Enter your bank name, account name, and account number. You can switch to Mobile Money if needed (MTN MoMo SA is available).',
  },
  {
    q: 'What currency does the South Africa invoice use?',
    a: 'The invoice uses <strong>South African Rand (R / ZAR)</strong> by default. All amounts — subtotal, SARS VAT 15%, and total — display in R.',
  },
  {
    q: 'Does a South African VAT invoice need to include a VAT registration number?',
    a: 'Yes — if you are a VAT-registered vendor, SARS requires your VAT registration number on tax invoices above R50. For amounts above R5,000, a full tax invoice must also include the client\'s VAT number. Add these in the Notes or Business Details fields on this tool.',
  },
  {
    q: 'What is the difference between a tax invoice and a standard invoice in South Africa?',
    a: 'A <strong>tax invoice</strong> (required for VAT-registered vendors) must show VAT registration numbers, the word "Tax Invoice", and the VAT amount separately. A <strong>standard invoice</strong> is for non-VAT-registered businesses and just shows the total amount. This tool generates a standard professional invoice — add "Tax Invoice" and VAT numbers in the invoice number field or notes if you\'re VAT-registered.',
  },
  {
    q: 'Can I issue invoices in USD for international clients from South Africa?',
    a: 'Yes. Change the currency symbol to <strong>$</strong> and the code to <strong>USD</strong>. For export services, set tax to 0% (zero-rated under SARS rules for exported services to non-resident clients).',
  },
];
---

<Base
  title="South Africa Invoice Generator — SARS VAT 15% Auto-filled Free — Afrinvoice"
  description="Create South Africa invoices with SARS VAT 15% pre-filled. Bank EFT payment fields. Free PDF download, no sign-up. For South African freelancers and businesses."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="country-hero" aria-labelledby="za-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">South Africa Invoice Generator</span>
      </nav>

      <div class="country-badge">
        <span aria-hidden="true">🇿🇦</span>
        South Africa · ZAR · SARS VAT 15%
      </div>

      <h1 id="za-heading" class="country-heading">
        South Africa Invoice Generator<br />
        <span class="shimmer">with SARS VAT auto-filled</span>
      </h1>

      <p class="country-sub">
        Select South Africa and your invoice is ready: <strong>R currency</strong>, <strong>SARS VAT 15%</strong>,
        and <strong>bank EFT payment fields</strong>. Download a professional PDF instantly.
        No account. No watermark.
      </p>

      <div class="country-highlights">
        <div class="highlight">
          <span class="hl-val">15%</span>
          <span class="hl-label">SARS VAT rate</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">R</span>
          <span class="hl-label">South African Rand</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">EFT</span>
          <span class="hl-label">Bank transfer default</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Invoice Generator ──────────────────────────────────────────── -->
  <section class="tool-section" aria-label="South Africa invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="south-africa" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <!-- ── Affiliate callout ──────────────────────────────────────────── -->
  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/how-to-invoice-south-africa/" class="guide-link">New to invoicing in South Africa? Read our complete guide →</a>
  </div>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="za-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="South Africa Invoice Generator — FAQs" />
    </div>
  </section>

</Base>

<style>
  .country-hero {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-4);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }

  .country-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.875rem;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.18);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #D97706;
    margin-bottom: 1.25rem;
  }

  .country-heading {
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .country-sub {
    font-size: clamp(1rem, 2vw, 1.0625rem);
    color: var(--text-3);
    line-height: 1.75;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .country-sub strong { color: var(--text-2); font-weight: 500; }

  .country-highlights {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .hl-val {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    font-family: 'Sora', sans-serif;
    line-height: 1;
  }

  .hl-label {
    font-size: 0.6875rem;
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .hl-sep {
    width: 1px;
    height: 2rem;
    background: var(--border);
    flex-shrink: 0;
  }

  .tool-section { padding: 0 0 2rem; }

  .tool-shell {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface);
    min-height: 640px;
    display: flex;
    flex-direction: column;
  }

  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
