---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/zimbabwe-invoice-generator/';
const schema   = webAppSchema(
  'Zimbabwe Invoice Generator — EcoCash & ZIMRA VAT',
  pageUrl,
  'Create professional Zimbabwe invoices with ZIMRA VAT 15.5% and EcoCash payment instructions auto-filled. Free PDF download, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Zimbabwe Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Zimbabwe invoice generator auto-fill ZIMRA VAT?',
    a: 'Yes. Zimbabwe Revenue Authority (ZIMRA) VAT at <strong>15.5%</strong> is pre-filled when you select Zimbabwe. You can edit the rate or set it to 0% for exempt or zero-rated supplies.',
  },
  {
    q: 'Can I add EcoCash payment instructions to my Zimbabwe invoice?',
    a: 'Yes. The payment section defaults to Mobile Money for Zimbabwe with EcoCash pre-selected. EcoCash has over 95% mobile money market share in Zimbabwe, making it the standard for small business payments. OneMoney is also available in the dropdown.',
  },
  {
    q: 'What currency does the Zimbabwe invoice use?',
    a: 'The invoice uses <strong>Zimbabwe Gold (ZWG)</strong> by default — the structured currency introduced in April 2024. You can change the currency symbol to <strong>USD</strong> if your client or contract specifies USD (common for B2B and international payments).',
  },
  {
    q: 'Can I issue Zimbabwe invoices in USD?',
    a: 'Yes. Zimbabwe has a dual-currency environment — many businesses invoice in USD and accept payment via USD EcoCash or bank transfer. Change the currency symbol to <strong>$</strong> and the code to <strong>USD</strong> in the tool.',
  },
  {
    q: 'Does this support ZIMRA e-invoicing requirements?',
    a: 'This tool generates standard professional invoice documents. ZIMRA\'s fiscal device / e-invoicing requirements apply to VAT-registered operators using certified fiscal devices. Use this tool to draft your invoice, then submit through your registered ZIMRA fiscal device if applicable.',
  },
  {
    q: 'Can I use OneMoney instead of EcoCash on my Zimbabwe invoice?',
    a: 'Yes. In the Payment Details section, switch to Mobile Money and select OneMoney (Netone) from the dropdown. Enter your OneMoney wallet number and name — these appear on your invoice PDF.',
  },
];
---

<Base
  title="Zimbabwe Invoice Generator — ZIMRA VAT 15.5%"
  description="Create Zimbabwe invoices with ZIMRA VAT 15.5% and EcoCash payment instructions auto-filled. ZWG or USD currency. Free PDF download, no sign-up."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="country-hero" aria-labelledby="zw-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Zimbabwe Invoice Generator</span>
      </nav>

      <div class="country-badge">
        <span aria-hidden="true">🇿🇼</span>
        Zimbabwe · ZWG · ZIMRA VAT 15.5%
      </div>

      <h1 id="zw-heading" class="country-heading">
        Zimbabwe Invoice Generator<br />
        <span class="shimmer">with EcoCash auto-filled</span>
      </h1>

      <p class="country-sub">
        Select Zimbabwe and your invoice is ready: <strong>ZWG currency</strong>, <strong>ZIMRA VAT 15.5%</strong>,
        and <strong>EcoCash payment fields</strong>. Switch to USD anytime.
        Download a professional PDF instantly. No account. No watermark.
      </p>

      <div class="country-highlights">
        <div class="highlight">
          <span class="hl-val">15.5%</span>
          <span class="hl-label">ZIMRA VAT rate</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">ZWG</span>
          <span class="hl-label">Zimbabwe Gold</span>
        </div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight">
          <span class="hl-val">EcoCash</span>
          <span class="hl-label">EcoCash · OneMoney</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Invoice Generator ──────────────────────────────────────────── -->
  <section class="tool-section" aria-label="Zimbabwe invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="zimbabwe" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <!-- ── Affiliate callout ──────────────────────────────────────────── -->
  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="zw-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Zimbabwe Invoice Generator — FAQs" headingId="zw-faq-heading" />
    </div>
  </section>

</Base>

<style>
  .country-hero {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-4);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }

  .country-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.875rem;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.18);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #D97706;
    margin-bottom: 1.25rem;
  }

  .country-heading {
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .country-sub {
    font-size: clamp(1rem, 2vw, 1.0625rem);
    color: var(--text-3);
    line-height: 1.75;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .country-sub strong { color: var(--text-2); font-weight: 500; }

  .country-highlights {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .hl-val {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    font-family: 'Sora', sans-serif;
    line-height: 1;
  }

  .hl-label {
    font-size: 0.6875rem;
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .hl-sep {
    width: 1px;
    height: 2rem;
    background: var(--border);
    flex-shrink: 0;
  }

  .tool-section { padding: 0 0 2rem; }

  .tool-shell {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface);
    min-height: 640px;
    display: flex;
    flex-direction: column;
  }

  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
