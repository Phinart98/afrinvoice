---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

const pageUrl  = 'https://afrinvoice.app/egypt-invoice-generator/';
const schema   = webAppSchema(
  'Egypt Invoice Generator — ETA VAT 14% Pre-filled',
  pageUrl,
  'Create professional Egypt invoices with ETA VAT 14% auto-filled. InstaPay and Fawry payment instructions. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: 'Afrinvoice', url: 'https://afrinvoice.app/' },
  { name: 'Egypt Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Does this Egypt invoice generator auto-fill ETA VAT?',
    a: 'Yes. Egyptian Tax Authority (ETA) VAT at <strong>14%</strong> is pre-filled when you select Egypt. Egypt also mandates e-invoicing for registered businesses via the ETA e-invoicing portal — this tool generates a compliant document for your records.',
  },
  {
    q: 'What is InstaPay and should I use it on my Egypt invoice?',
    a: '<strong>InstaPay</strong> is Egypt\'s instant interbank payment platform, operated by the Egyptian Banks Company. It allows real-time transfers between any Egyptian bank account using a mobile number or national ID. It\'s the preferred payment method for modern B2B transactions in Egypt.',
  },
  {
    q: 'What currency does the Egypt invoice use?',
    a: 'Egyptian Pound (EGP), displayed as <strong>E£</strong>. All amounts — subtotal, ETA VAT 14%, and total — appear in Egyptian Pounds.',
  },
  {
    q: 'Can I invoice international clients in USD from Egypt?',
    a: 'Yes. Many Egyptian IT professionals, engineers, and consultants invoice international clients in USD. Change the currency to USD in the tool, set VAT to 0% for export services, and include your USD bank account details. Wise is also widely used by Egyptian freelancers.',
  },
];
---

<Base
  title="Egypt Invoice Generator — ETA VAT 14%"
  description="Create Egypt invoices with ETA VAT 14% pre-filled. InstaPay and Fawry payment instructions included. Free PDF download, no sign-up required."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>
  <section class="country-hero" aria-labelledby="eg-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Afrinvoice</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Egypt Invoice Generator</span>
      </nav>
      <div class="country-badge"><span aria-hidden="true">🇪🇬</span> Egypt · EGP · ETA VAT 14%</div>
      <h1 id="eg-heading" class="country-heading">
        Egypt Invoice Generator<br />
        <span class="shimmer">with ETA VAT auto-filled</span>
      </h1>
      <p class="country-sub">
        Select Egypt: <strong>Pound currency</strong>, <strong>ETA VAT 14%</strong>, and <strong>InstaPay</strong> payment fields.
        Download a professional PDF instantly. No account. No watermark.
      </p>
      <div class="country-highlights">
        <div class="highlight"><span class="hl-val">14%</span><span class="hl-label">ETA VAT rate</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">E£</span><span class="hl-label">Egyptian Pound</span></div>
        <div class="hl-sep" aria-hidden="true"></div>
        <div class="highlight"><span class="hl-val">Pay</span><span class="hl-label">InstaPay · Fawry</span></div>
      </div>
    </div>
  </section>

  <section class="tool-section" aria-label="Egypt invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" countryPreset="egypt" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="freshbooks" />
  </div>

  <div class="container guide-link-wrap">
    <a href="/mobile-money-invoice/" class="guide-link">Invoice with mobile money payment fields →</a>
  </div>

  <section class="section" aria-labelledby="eg-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Egypt Invoice Generator — FAQs" headingId="eg-faq-heading" />
    </div>
  </section>
</Base>

<style>
  .country-hero { padding: 4rem 0 3rem; text-align: center; }
  .breadcrumb { display: flex; justify-content: center; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .country-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3125rem 0.875rem; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.18); border-radius: 9999px; font-size: 0.8125rem; font-weight: 500; color: #D97706; margin-bottom: 1.25rem; }
  .country-heading { font-size: clamp(1.875rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin-bottom: 1.25rem; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .country-sub { font-size: clamp(1rem, 2vw, 1.0625rem); color: var(--text-3); line-height: 1.75; max-width: 36rem; margin: 0 auto 2rem; }
  .country-sub strong { color: var(--text-2); font-weight: 500; }
  .country-highlights { display: flex; align-items: center; justify-content: center; gap: 1.5rem; }
  .highlight { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .hl-val { font-size: 1.25rem; font-weight: 700; color: var(--text); font-family: 'Sora', sans-serif; line-height: 1; }
  .hl-label { font-size: 0.6875rem; color: var(--text-4); text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .hl-sep { width: 1px; height: 2rem; background: var(--border); flex-shrink: 0; }
  .tool-section { padding: 0 0 2rem; }
  .tool-shell { border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; background: var(--surface); min-height: 640px; display: flex; flex-direction: column; }
  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
