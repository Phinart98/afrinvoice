---
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema } from '../../utils/schema';
import { SITE, abs } from '../../site';

const pageUrl    = abs('/contact/');
const breadcrumb = breadcrumbSchema([
  { name: SITE.name, url: abs('/') },
  { name: 'Contact', url: pageUrl },
]);
---

<Base
  title={`Contact ${SITE.name}: Report an Error or Request a Country`}
  description={`Get in touch with the ${SITE.name} team. Report a wrong VAT rate, request a new country, or ask a question about the invoice generator.`}
  schema={breadcrumb}
>
  <div class="contact-wrap">
    <div class="container-narrow">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">{SITE.name}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Contact</span>
      </nav>

      <header class="contact-header">
        <h1 class="contact-heading">Contact {SITE.name}</h1>
        <p class="contact-lead">Questions, corrections and country requests all come to one inbox, and we read everything.</p>
      </header>

      <div class="contact-options">

        <div class="contact-card">
          <div class="cc-icon" aria-hidden="true">✱</div>
          <h2>Report a data error</h2>
          <p>
            VAT rates change. Payment providers rebrand. If something looks wrong for your
            country, such as a rate, a provider name or a missing provider, use the
            <strong>"Something wrong? Tell us"</strong> link in the tool directly.
            It's the fastest way to get it fixed.
          </p>
        </div>

        <div class="contact-card">
          <div class="cc-icon" aria-hidden="true">✦</div>
          <h2>Request a country</h2>
          <p>
            Don't see your country? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            with the subject "Country request: [Country name]". Include the currency, main tax authority,
            VAT rate, and dominant payment method. If you can point to an official source, even better.
          </p>
        </div>

        <div class="contact-card">
          <div class="cc-icon" aria-hidden="true">◆</div>
          <h2>Everything else</h2>
          <p>
            For bugs, feature ideas, partnerships or press, email
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
            We aim to respond within 2 business days.
          </p>
        </div>

      </div>

    </div>
  </div>
</Base>

<style>
  .contact-wrap { padding: 3rem 0 5rem; }
  .contact-heading { font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; letter-spacing: -0.025em; color: var(--text); margin-bottom: 0.75rem; }
  .contact-lead { font-size: 1.0625rem; color: var(--text-3); line-height: 1.75; }
  .contact-options { margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .contact-card { padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .cc-icon { font-size: 1.25rem; color: var(--accent); margin-bottom: 0.625rem; }
  .contact-card h2 { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 0.5rem; }
  .contact-card p { font-size: 0.9375rem; color: var(--text-2); line-height: 1.7; margin: 0; }
  .contact-card a { color: var(--accent); text-decoration: none; }
  .contact-card a:hover { text-decoration: underline; }
</style>
