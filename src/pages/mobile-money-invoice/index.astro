---
import Base from '../../layouts/Base.astro';
import AdUnit from '../../components/AdUnit.astro';
import FaqSection from '../../components/FaqSection.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import InvoiceGenerator from '../../components/InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';
import { SITE, abs } from '../../site';

const pageUrl   = abs('/mobile-money-invoice/');
const schema    = webAppSchema(
  'Invoice with Mobile Money Payment Instructions — Africa',
  pageUrl,
  'Create invoices with MTN MoMo, M-Pesa, EcoCash, OPay payment instructions. Select your country — correct providers auto-fill. Free PDF, no sign-up.',
);
const breadcrumb = breadcrumbSchema([
  { name: SITE.name, url: abs('/') },
  { name: 'Mobile Money Invoice Generator', url: pageUrl },
]);

const faqs: import('../../components/FaqSection.astro').FaqItem[] = [
  {
    q: 'Which mobile money providers are supported?',
    a: 'Select your country and the correct providers appear automatically: <strong>MTN MoMo</strong>, <strong>Telecel Cash</strong>, <strong>AirtelTigo Money</strong> (Ghana); <strong>M-Pesa</strong>, <strong>Airtel Money</strong> (Kenya); <strong>EcoCash</strong>, <strong>OneMoney</strong> (Zimbabwe); <strong>OPay</strong>, <strong>PalmPay</strong>, <strong>MTN MoMo PSB</strong> (Nigeria); and many more across 17 African countries.',
  },
  {
    q: 'How do I add my MTN MoMo number to my invoice?',
    a: 'Select Ghana (or your country), switch Payment Details to Mobile Money, choose MTN MoMo from the dropdown, enter your phone number and account name. Your MoMo details appear clearly in the invoice PDF under "Payment Details".',
  },
  {
    q: 'Can I add M-Pesa payment instructions to a Kenya invoice?',
    a: 'Yes. Select Kenya — the tool defaults to Mobile Money with M-Pesa pre-selected. Enter your Safaricom number (07XXXXXXXX) and the name on your M-Pesa account. Airtel Money is also available.',
  },
  {
    q: 'Should I use mobile money or bank transfer for B2B invoices?',
    a: 'It depends on the country and client type. In <strong>Ghana</strong> and <strong>Kenya</strong>, mobile money is widely accepted for B2B payments under ~$500. In <strong>Nigeria</strong>, bank transfer (NEFT/NIBSS) is the B2B standard — most businesses prefer account numbers. In <strong>South Africa</strong>, bank EFT is standard for all B2B. This tool defaults correctly per country.',
  },
  {
    q: 'Can I include both bank and mobile money details on the same invoice?',
    a: 'Currently the tool shows one payment method at a time. To include both, select your primary method, download the PDF, then add the secondary details in the Notes field (e.g. "Also accept MTN MoMo: 024XXXXXXX").',
  },
  {
    q: 'Does EcoCash work for international payments in Zimbabwe?',
    a: 'EcoCash is primarily for ZWG (Zimbabwe Gold) domestic payments. For USD payments — common in Zimbabwe — use a bank USD account and note it in the payment section. Many Zimbabwean businesses operate dual ZWG/USD accounts.',
  },
];
---

<Base
  title="Invoice with Mobile Money Payment Fields"
  description="Create invoices with MTN MoMo, M-Pesa, EcoCash, OPay payment instructions. Select your African country — correct providers auto-fill. Free PDF, no sign-up."
  schema={[schema, breadcrumb, faqSchema(faqs)]}
>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="tool-hero" aria-labelledby="momo-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">{SITE.name}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Mobile Money Invoice Generator</span>
      </nav>

      <h1 id="momo-heading" class="tool-heading">
        Invoice with mobile money payment instructions
      </h1>

      <p class="tool-sub">
        Pick your country and the invoice offers the mobile money providers people there actually use:
        MTN MoMo in Ghana, M-Pesa in Kenya, EcoCash in Zimbabwe, OPay in Nigeria and Airtel Money in Uganda.
        It’s free and there’s nothing to sign up for.
      </p>
    </div>
  </section>

  <!-- ── Invoice Generator ──────────────────────────────────────────── -->
  <section class="tool-section" aria-label="Mobile money invoice generator">
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <!-- ── Affiliate callout ──────────────────────────────────────────── -->
  <div class="container affiliate-wrap">
    <AffiliateCallout affiliate="wise" />
  </div>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="momo-faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Questions about mobile money invoices" headingId="momo-faq-heading" />
    </div>
  </section>

</Base>

<style>
  .tool-hero {
    padding: 4rem 0 3rem;
  }


  .tool-heading {
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: 40rem;
  }

  .tool-sub {
    font-size: clamp(1rem, 2vw, 1.0625rem);
    color: var(--text-2);
    line-height: 1.75;
    max-width: 38rem;
    margin: 0 0 1.75rem;
  }
  .tool-sub strong { color: var(--text-2); font-weight: 500; }





  .affiliate-wrap { padding-top: 0.5rem; padding-bottom: 1rem; }
</style>
