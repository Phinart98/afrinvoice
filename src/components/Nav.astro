---
import { COUNTRIES, FEATURED_COUNTRIES, countryPath } from '../data/countries';
import { SITE } from '../site';

// Wordmark: first word regular, the rest bold ("Invoice **Passport**").
const [brandFirst, ...brandRestParts] = SITE.name.split(' ');
const brandRest = brandRestParts.join(' ');

const countryLinks = [
  ...FEATURED_COUNTRIES.map(c => ({ href: countryPath(c), label: c.name })),
  { href: '/invoice-requirements-by-country/', label: `All ${COUNTRIES.length} countries` },
];

const toolLinks = [
  { href: '/quote-generator/',     label: 'Quote / estimate' },
  { href: '/receipt-generator/',   label: 'Receipt' },
  { href: '/proforma-invoice/',    label: 'Proforma invoice' },
  { href: '/credit-note/',         label: 'Credit note' },
  { href: '/freelancer-invoice/',  label: 'Freelancer invoice' },
  { href: '/invoice-templates/',   label: 'Invoice templates' },
];

const guideLinks = [
  { href: '/invoice-requirements-by-country/', label: 'Invoice rules by country' },
  { href: '/invoice-number-format/',           label: 'Invoice number format' },
  { href: '/how-to-invoice-nigeria/',          label: 'How to invoice in Nigeria' },
  { href: '/how-to-invoice-ghana/',            label: 'How to invoice in Ghana' },
  { href: '/how-to-invoice-kenya/',            label: 'How to invoice in Kenya' },
  { href: '/how-to-invoice-south-africa/',     label: 'How to invoice in South Africa' },
];

const mobileLinks = [
  { divider: 'Countries' },
  ...countryLinks,
  { divider: 'Tools' },
  ...toolLinks,
  { divider: 'Guides' },
  ...guideLinks,
  { divider: 'More' },
  { href: '/about/',   label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy/', label: 'Privacy' },
];

const pathname = Astro.url.pathname;
const isCountriesActive = countryLinks.some(l => pathname.startsWith(l.href));
const isGuidesActive = guideLinks.some(l => pathname.startsWith(l.href));
const isToolsActive = toolLinks.some(l => pathname.startsWith(l.href));
---

<header class="nav-header" role="banner">
  <div class="nav-inner">

    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label={`${SITE.name} home`}>
      <svg class="nav-logo-icon" width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <rect x="2" y="1" width="17" height="22" rx="2.5" fill="#111827" stroke="#0F766E" stroke-width="1.5"/>
        <rect x="2" y="1" width="17" height="7" rx="2.5" fill="#0F766E"/>
        <rect x="2" y="5.5" width="17" height="2.5" fill="#0F766E"/>
        <line x1="5.5" y1="12.5" x2="16.5" y2="12.5" stroke="#475569" stroke-width="1.1" stroke-linecap="round"/>
        <line x1="5.5" y1="15.5" x2="13"   y2="15.5" stroke="#475569" stroke-width="1.1" stroke-linecap="round"/>
        <line x1="5.5" y1="19.5" x2="16.5" y2="19.5" stroke="#0F766E" stroke-width="1.5" stroke-linecap="round"/>
        <!-- Checkmark badge -->
        <circle cx="20" cy="20" r="5" fill="#0A0F1E" stroke="#0F766E" stroke-width="1.25"/>
        <path d="M17.5 20l1.8 1.8 3.2-3.2" stroke="#0F766E" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="nav-logo-text">{brandFirst} <span class="nav-logo-bold">{brandRest}</span></span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-links hidden md:flex" aria-label="Main navigation">

      <!-- Countries dropdown -->
      <div class="nav-dropdown" id="nav-countries-dropdown">
        <button
          class:list={['nav-link', 'nav-dropdown-trigger', { active: isCountriesActive }]}
          aria-expanded="false"
          aria-controls="nav-countries-panel"
          id="nav-countries-btn"
        >
          Countries
          <svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="nav-dropdown-panel" id="nav-countries-panel" aria-hidden="true">
          {countryLinks.map(link => (
            <a
              href={link.href}
              class:list={['nav-dropdown-item', { active: pathname === link.href }]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Tools dropdown -->
      <div class="nav-dropdown" id="nav-tools-dropdown">
        <button
          class:list={['nav-link', 'nav-dropdown-trigger', { active: isToolsActive }]}
          aria-expanded="false"
          aria-controls="nav-tools-panel"
          id="nav-tools-btn"
        >
          Tools
          <svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="nav-dropdown-panel" id="nav-tools-panel" aria-hidden="true">
          {toolLinks.map(link => (
            <a href={link.href} class:list={['nav-dropdown-item', { active: pathname === link.href }]}>
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Guides dropdown -->
      <div class="nav-dropdown" id="nav-guides-dropdown">
        <button
          class:list={['nav-link', 'nav-dropdown-trigger', { active: isGuidesActive }]}
          aria-expanded="false"
          aria-controls="nav-guides-panel"
          id="nav-guides-btn"
        >
          Guides
          <svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="nav-dropdown-panel" id="nav-guides-panel" aria-hidden="true">
          {guideLinks.map(link => (
            <a
              href={link.href}
              class:list={['nav-dropdown-item', { active: pathname === link.href }]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

    </nav>

    <div class="nav-end">
    <!-- Light / dark switch. The saved choice is applied before paint in Base.astro. -->
    <button type="button" class="nav-theme" id="theme-toggle" aria-label="Switch to dark mode">
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16 12.5A7 7 0 017.5 4a7 7 0 108.5 8.5z" fill="currentColor"/></svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.5" fill="currentColor"/><path d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.8 1.8M14.2 14.2L16 16M4 16l1.8-1.8M14.2 5.8L16 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>

    <!-- Mobile toggle -->
    <button
      class="nav-mobile-btn flex md:hidden"
      id="nav-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <line id="burger-top" x1="3" y1="5"  x2="17" y2="5"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line id="burger-mid" x1="3" y1="10" x2="17" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line id="burger-bot" x1="3" y1="15" x2="17" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="nav-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
    {mobileLinks.map((item) =>
      'divider' in item ? (
        <span class="nav-mobile-divider">{item.divider}</span>
      ) : (
        <a
          href={item.href}
          class:list={['nav-mobile-link', { active: pathname === item.href || pathname.startsWith(item.href) }]}
        >
          {item.label}
        </a>
      )
    )}
  </div>
</header>

<script>
  // Light / dark switch: flips away from whatever is showing now, and remembers it
  const themeBtn = document.getElementById('theme-toggle');
  const isDark = () => document.documentElement.dataset.theme
    ? document.documentElement.dataset.theme === 'dark'
    : matchMedia('(prefers-color-scheme: dark)').matches;
  const labelTheme = () => themeBtn?.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
  labelTheme();
  themeBtn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    labelTheme();
  });

  // Mobile hamburger
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-mobile-menu');
  let isOpen   = false;

  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
    menu?.classList.toggle('open', isOpen);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isOpen) {
      isOpen = false;
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.classList.remove('open');
    }
  });

  // Generic dropdown factory
  function initDropdown(wrapperId: string, btnId: string, panelId: string) {
    const wrap  = document.getElementById(wrapperId);
    const btn   = document.getElementById(btnId);
    const panel = document.getElementById(panelId);
    let open = false;

    function openD()  { open = true;  wrap?.classList.add('open');    btn?.setAttribute('aria-expanded', 'true');  panel?.setAttribute('aria-hidden', 'false'); }
    function closeD() { open = false; wrap?.classList.remove('open'); btn?.setAttribute('aria-expanded', 'false'); panel?.setAttribute('aria-hidden', 'true');  }

    btn?.addEventListener('click', (e) => { e.stopPropagation(); open ? closeD() : openD(); });
    document.addEventListener('click', (e) => { if (open && !wrap?.contains(e.target as Node)) closeD(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) closeD(); });
  }

  initDropdown('nav-countries-dropdown', 'nav-countries-btn', 'nav-countries-panel');
  initDropdown('nav-guides-dropdown',    'nav-guides-btn',    'nav-guides-panel');
  initDropdown('nav-tools-dropdown',     'nav-tools-btn',     'nav-tools-panel');
</script>

<style>
  /* ── Nav shell ───────────────────────────────────── */
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 3.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* ── Logo ────────────────────────────────────────── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-icon { flex-shrink: 0; }

  .nav-logo-text {
    font-family: var(--font);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-3);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .nav-logo-bold {
    color: var(--text);
    font-weight: 800;
  }
  .nav-logo:hover .nav-logo-text { color: var(--text-2); }

  /* ── Desktop links ───────────────────────────────── */
  .nav-links {
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: all 150ms;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    white-space: nowrap;
  }
  .nav-link:hover  { color: var(--text); background: var(--surface-2); }
  .nav-link.active { color: var(--accent); }

  /* ── Guides dropdown ─────────────────────────────── */
  .nav-dropdown { position: relative; }

  .nav-chevron { transition: transform 200ms; flex-shrink: 0; }
  .nav-dropdown.open .nav-chevron { transform: rotate(180deg); }

  .nav-dropdown-panel {
    position: absolute;
    top: calc(100% + 0.625rem);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    width: 260px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.375rem;
    z-index: 99;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms, transform 180ms;
    box-shadow: var(--shadow-lg);
  }
  .nav-dropdown.open .nav-dropdown-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--text-2);
    text-decoration: none;
    transition: all 150ms;
  }
  .nav-dropdown-item:hover { color: var(--text); background: var(--surface-2); }
  .nav-dropdown-item.active { color: var(--accent); }
  
  /* ── Mobile button ───────────────────────────────── */
  .nav-mobile-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    align-items: center;
    border-radius: 6px;
    transition: background 150ms;
  }
  .nav-mobile-btn:hover { background: var(--surface-2); }

  .nav-end { display: flex; align-items: center; gap: 0.25rem; }
  .nav-theme {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem;
    background: none; border: none; border-radius: 6px;
    color: var(--text-3); cursor: pointer;
  }
  .nav-theme:hover { color: var(--text); background: var(--surface-2); }
  .icon-sun { display: none; }
  :global(:root[data-theme="dark"]) .icon-sun { display: block; }
  :global(:root[data-theme="dark"]) .icon-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-sun { display: block; }
    :global(:root:not([data-theme="light"])) .icon-moon { display: none; }
  }
  .nav-mobile-btn { color: var(--text-3); }

  /* ── Mobile menu ─────────────────────────────────── */
  .nav-mobile-menu {
    display: none;
    flex-direction: column;
    gap: 2px;
    padding: 0.75rem 1rem 1rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .nav-mobile-menu.open { display: flex; }

  .nav-mobile-link {
    display: block;
    padding: 0.5625rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    color: var(--text-2);
    text-decoration: none;
    transition: all 150ms;
  }
  .nav-mobile-link:hover  { color: var(--text); background: var(--surface-2); }
  .nav-mobile-link.active { color: var(--accent); }

  .nav-mobile-divider {
    display: block;
    padding: 0.625rem 0.75rem 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-4);
    user-select: none;
    pointer-events: none;
  }

  /* ── Hamburger → X animation ─────────────────────── */
  #burger-top, #burger-mid, #burger-bot {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 260ms ease, opacity 260ms ease;
  }
  #nav-toggle[aria-expanded="true"] #burger-top { transform: translateY(5px) rotate(45deg); }
  #nav-toggle[aria-expanded="true"] #burger-mid { opacity: 0; }
  #nav-toggle[aria-expanded="true"] #burger-bot { transform: translateY(-5px) rotate(-45deg); }
</style>
