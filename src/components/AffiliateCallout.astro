---
// Set to true once affiliate accounts are approved
const AFFILIATES_ENABLED = false;

type Affiliate = 'freshbooks' | 'quickbooks' | 'wise';
type Variant   = 'inline' | 'compact';

interface Props {
  affiliate: Affiliate;
  variant?: Variant;
}

const { affiliate, variant = 'inline' } = Astro.props;

const configs: Record<Affiliate, {
  label: string;
  description: string;
  cta: string;
  href: string;
  icon: string;
}> = {
  freshbooks: {
    label: 'FreshBooks',
    description: 'Need recurring invoices, time tracking & expense management?',
    cta: 'Try FreshBooks free →',
    href: '#freshbooks-affiliate',   // replace with real affiliate link
    icon: '📊',
  },
  quickbooks: {
    label: 'QuickBooks',
    description: 'Running a growing business that needs full accounting?',
    cta: 'Try QuickBooks free →',
    href: '#quickbooks-affiliate',   // replace with real affiliate link
    icon: '📈',
  },
  wise: {
    label: 'Wise Business',
    description: 'Invoice international clients and receive payments in 40+ currencies.',
    cta: 'Open a Wise account →',
    href: '#wise-affiliate',         // replace with real affiliate link
    icon: '🌍',
  },
};

const c = configs[affiliate];
---

{AFFILIATES_ENABLED && <aside class:list={['affiliate', `affiliate--${variant}`]} aria-label={`Recommended: ${c.label}`}>
  <span class="affiliate-icon" aria-hidden="true">{c.icon}</span>
  <div class="affiliate-body">
    <p class="affiliate-text">
      <strong>{c.description}</strong>
    </p>
  </div>
  <a href={c.href} rel="nofollow sponsored noopener" target="_blank" class="affiliate-cta">
    {c.cta}
  </a>
</aside>}

<style>
  .affiliate {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 48rem;
    margin: 0 auto;
    flex-wrap: wrap;
  }

  .affiliate--compact {
    padding: 0.625rem 1rem;
    gap: 0.75rem;
  }

  .affiliate-icon {
    font-size: 1.375rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .affiliate-body { flex: 1; min-width: 180px; }

  .affiliate-text {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.5;
    margin: 0;
  }
  .affiliate-text strong {
    color: var(--text);
    font-weight: 500;
  }

  .affiliate-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.4375rem 0.875rem;
    background: var(--accent-dim);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--ease);
    flex-shrink: 0;
  }
  .affiliate-cta:hover {
    background: rgba(245, 158, 11, 0.18);
    color: var(--accent-hover);
    border-color: rgba(245, 158, 11, 0.4);
  }
</style>
