---
export interface FaqItem {
  q: string;
  a: string; // HTML allowed
}

interface Props {
  items: FaqItem[];
  heading?: string;
  headingId?: string;
  class?: string;
}

const { items, heading = 'Frequently Asked Questions', headingId, class: className } = Astro.props;
import { SITE } from '../site';
---

<script>
  // Close other items when one opens — exclusive accordion behaviour
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(item => {
    item.addEventListener('toggle', () => {
      if (item.open) {
        document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(other => {
          if (other !== item && other.open) other.open = false;
        });
      }
    });
  });
</script>

<section class:list={['faq-section', className]}>
  <div class="faq-side">
    <h2 class="faq-heading" id={headingId}>{heading}</h2>
    <p class="faq-help">Can’t find your answer? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  </div>
  <div class="faq-list">
    {items.map(({ q, a }) => (
      <details class="faq-item">
        <summary class="faq-question">
          <span>{q}</span>
          <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.5 5.5L8 10l4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="faq-answer" set:html={a} />
      </details>
    ))}
  </div>
</section>

<style>
  /* Two columns on wide screens: the heading on the left, questions on the right */
  .faq-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1.5rem 4rem;
    align-items: start;
  }
  @media (max-width: 899px) {
    .faq-section { grid-template-columns: 1fr; }
  }

  .faq-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .faq-help { font-size: 0.9375rem; color: var(--text-2); max-width: 22rem; }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }
  .faq-item:first-child { border-top: 1px solid var(--border); }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 0;
    cursor: pointer;
    list-style: none;
    font: 700 1.0625rem var(--font-display);
    color: var(--text);
    transition: color var(--ease);
    user-select: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover { color: var(--text-2); }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-3);
    transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1), color var(--ease);
  }
  details[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--text);
  }
  details[open] .faq-question { color: var(--text); }

  .faq-answer {
    padding: 0 0 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--text-2);
    max-width: 44rem;
  }

  /* Style inline links inside FAQ answers */
  .faq-answer :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .faq-answer :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
</style>
