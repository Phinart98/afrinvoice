---
// Shared shell for the document-type tool pages (quote, receipt, proforma, credit note,
// freelancer). Each page supplies its own copy, FAQ and guide section via the slot.
import Base from '../layouts/Base.astro';
import AdUnit from './AdUnit.astro';
import FaqSection from './FaqSection.astro';
import InvoiceGenerator from './InvoiceGenerator.vue';
import { webAppSchema, breadcrumbSchema, faqSchema } from '../utils/schema';
import { SITE, abs } from '../site';
import type { FaqItem } from './FaqSection.astro';
import type { DocType } from '../i18n/labels';

interface Props {
  path: string;
  title: string;
  description: string;
  badge: string;
  heading: string;
  sub: string;
  docPreset?: DocType;
  faqs: FaqItem[];
}

const { path, title, description, badge, heading, sub, docPreset, faqs } = Astro.props;
const url = abs(path);
---

<Base
  title={title}
  description={description}
  schema={[
    webAppSchema(heading, url, description),
    breadcrumbSchema([{ name: SITE.name, url: abs('/') }, { name: heading, url }]),
    faqSchema(faqs),
  ]}
>
  <section class="country-hero" aria-labelledby="tool-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">{SITE.name}</a><span aria-hidden="true">›</span><span aria-current="page">{heading}</span>
      </nav>
      <div class="country-badge">{badge}</div>
      <h1 id="tool-heading" class="country-heading">{heading}</h1>
      <p class="country-sub" set:html={sub} />
    </div>
  </section>

  <section class="tool-section" aria-label={heading}>
    <div class="container">
      <div class="tool-shell">
        <InvoiceGenerator client:only="vue" docPreset={docPreset} />
      </div>
    </div>
  </section>

  <AdUnit slot="tool-below" />

  <section class="section">
    <div class="container doc-prose">
      <slot />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <FaqSection items={faqs} heading="Frequently asked questions" headingId="faq-heading" />
    </div>
  </section>
</Base>

<style>
  .doc-prose { max-width: 46rem; }
  .doc-prose :global(h2) { font-size: 1.375rem; margin: 2rem 0 0.75rem; letter-spacing: -0.02em; }
  .doc-prose :global(h2:first-child) { margin-top: 0; }
  .doc-prose :global(p), .doc-prose :global(li) { color: var(--text-2); line-height: 1.7; }
  .doc-prose :global(ul), .doc-prose :global(ol) { padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.375rem; margin: 0.5rem 0 1rem; }
  .doc-prose :global(a) { color: var(--accent); }
</style>
