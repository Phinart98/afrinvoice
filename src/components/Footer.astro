---
import { COUNTRIES, FEATURED_COUNTRIES, countryPath } from '../data/countries';
import { SITE } from '../site';

// Wordmark: first word regular, the rest bold ("Invoice **Passport**").
const [brandFirst, ...brandRestParts] = SITE.name.split(' ');
const brandRest = brandRestParts.join(' ');

const invoiceTools = [
  { href: '/',                      label: 'Invoice generator' },
  { href: '/quote-generator/',      label: 'Quote generator' },
  { href: '/receipt-generator/',    label: 'Receipt generator' },
  { href: '/proforma-invoice/',     label: 'Proforma invoice' },
  { href: '/credit-note/',          label: 'Credit note' },
  { href: '/freelancer-invoice/',   label: 'Freelancer invoice' },
  { href: '/mobile-money-invoice/', label: 'Mobile money invoice' },
  { href: '/invoice-templates/',    label: 'Invoice templates' },
];

const countries = [
  ...FEATURED_COUNTRIES.map(c => ({ href: countryPath(c), label: c.name })),
  { href: '/invoice-requirements-by-country/', label: `All ${COUNTRIES.length} countries` },
];

const resources = [
  { href: '/invoice-requirements-by-country/', label: 'Invoice rules by country' },
  { href: '/invoice-number-format/',           label: 'Invoice number format' },
  { href: '/how-to-invoice-nigeria/',          label: 'How to invoice in Nigeria' },
  { href: '/how-to-invoice-south-africa/',     label: 'How to invoice in South Africa' },
];

const site = [
  { href: '/about/',   label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/pro/',           label: 'Pro' },
  { href: '/privacy/',       label: 'Privacy' },
  { href: '/terms/',         label: 'Terms' },
  { href: '/refund-policy/', label: 'Refunds' },
];
---

<footer class="footer">
  <div class="footer-inner">

    <!-- Brand -->
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={`${SITE.name} home`}>
        <svg width="22" height="22" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <rect x="3" y="1" width="16" height="21" rx="3" fill="currentColor"/>
        <path d="M7 7.5h8M7 11.5h8M7 15.5h4.5" style="stroke: var(--bg, #F3F4F7)" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="19.5" cy="19.5" r="5.5" fill="#E4572E"/>
        <path d="M17 19.6l1.7 1.7 3.2-3.3" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="footer-logo-text">{brandFirst} <strong>{brandRest}</strong></span>
      </a>
      <p class="footer-tagline">
        {SITE.tagline}. Free, no sign-up, and your data never leaves your browser.
      </p>
      <p class="footer-copy">&copy; {new Date().getFullYear()} {SITE.name}<br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>

    <!-- Nav groups -->
    <div class="footer-nav-groups">

      <div class="footer-nav-group">
        <span class="footer-nav-heading">Invoice tools</span>
        <nav aria-label="Invoice tools navigation">
          {invoiceTools.map(l => <a href={l.href} class="footer-nav-link">{l.label}</a>)}
        </nav>
      </div>

      <div class="footer-nav-group">
        <span class="footer-nav-heading">Countries</span>
        <nav aria-label="Countries navigation">
          {countries.map(l => <a href={l.href} class="footer-nav-link">{l.label}</a>)}
        </nav>
      </div>

      <div class="footer-nav-group">
        <span class="footer-nav-heading">Resources</span>
        <nav aria-label="Resources navigation">
          {resources.map(l => <a href={l.href} class="footer-nav-link">{l.label}</a>)}
        </nav>
      </div>

      <div class="footer-nav-group">
        <span class="footer-nav-heading">Site</span>
        <nav aria-label="Site navigation">
          {site.map(l => <a href={l.href} class="footer-nav-link">{l.label}</a>)}
        </nav>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    padding: 3rem 0 2rem;
    margin-top: 5rem;
  }

  .footer-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ── Brand ───────────────────────────────────────── */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-logo svg { color: var(--footer-head); }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .footer-logo-text {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--footer-text);
    letter-spacing: -0.02em;
  }
  .footer-logo-text strong {
    color: var(--footer-head);
    font-weight: 800;
  }
  .footer-logo:hover .footer-logo-text        { color: var(--footer-head); }
  .footer-logo:hover .footer-logo-text strong { color: var(--footer-head); }

  /* Fixed: readable on dark background */
  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--footer-text);
    line-height: 1.6;
    max-width: 26ch;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--footer-text);
    line-height: 1;
    margin-top: 0.25rem;
  }

  /* ── Nav groups ──────────────────────────────────── */
  /* Mobile: 2 columns at all sizes — compact, space-efficient */
  .footer-nav-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 1.5rem;
  }

  .footer-nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav-heading {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--footer-head);
    margin-bottom: 0.25rem;
  }

  /* Links must be block so they stack vertically, not flow inline */
  .footer-nav-group nav {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .footer-nav-link {
    display: block;
    font-size: 0.8125rem;
    color: var(--footer-text);
    text-decoration: none;
    transition: color 150ms;
    line-height: 1.5;
  }
  .footer-nav-link:hover { color: var(--footer-head); }

  /* Small mobile: tighten font so long labels wrap less */
  @media (max-width: 559px) {
    .footer-nav-link    { font-size: 0.75rem; }
    .footer-nav-heading { font-size: 0.8125rem; }
    .footer-nav-groups  { gap: 1.75rem 1.25rem; }
  }

  /* ── Tablet: brand + nav side-by-side, nav stays 2×2 ── */
  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 4rem;
    }
    .footer-brand {
      flex-shrink: 0;
      width: 180px;
    }
    .footer-nav-groups {
      flex: 1;
      /* stays 2×2 — columns are wide enough for link text */
    }
  }

  /* ── Desktop: expand nav to 3 columns ── */
  @media (min-width: 1100px) {
    .footer-brand { width: 220px; }
    .footer-nav-groups {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem 3rem;
    }
  }
</style>

<style>
  .footer-copy { line-height: 1.6; }
  .footer-copy a { color: var(--footer-text); }
  .footer-copy a:hover { color: var(--footer-head); }
</style>
